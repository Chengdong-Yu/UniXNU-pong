+/// A module [`decode_kept`] decoded: its bytes, their SHA-256, the decode, and the ledger bytes the
+/// decode left charged.
+struct KeptDecode {
+    bytes: Arc<[u8]>,
+    sha: Hash256,
+    decoded: Arc<air::Decoded>,
+    charged: u64,
+}
