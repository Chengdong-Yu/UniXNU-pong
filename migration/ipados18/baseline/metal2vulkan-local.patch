+// Compare host address ranges without touching their bytes. Object identity covers private
+// memory; host ranges additionally cover distinct imports of an IOSurface or overlapping
+// no-copy buffers. Unknown arithmetic is conservative. Rebinding is not performed by this
+// consumer, and callers must not remap these ranges while the resources are in use.
+fn buffers_overlap(a: &Buffer, b: &Buffer) -> bool {
+    if a == b {
+        return true;
+    }
+    let (Some(a_start), Some(b_start)) = (a.contents(), b.contents()) else {
+        return false;
+    };
+    let (Ok(a_len), Ok(b_len)) = (usize::try_from(a.length()), usize::try_from(b.length())) else {
+        return true;
+    };
+    let a_start = a_start.as_ptr() as usize;
+    let b_start = b_start.as_ptr() as usize;
+    let (Some(a_end), Some(b_end)) = (a_start.checked_add(a_len), b_start.checked_add(b_len)) else {
+        return true;
+    };
+    a_start < b_end && b_start < a_end
+}
