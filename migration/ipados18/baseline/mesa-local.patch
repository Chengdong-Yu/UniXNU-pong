+static const struct tu_knl darwin_knl_funcs = {
+   .name = "darwin",
+
+   .device_init = darwin_device_init,
+   .device_finish = darwin_device_finish,
+   .device_get_gpu_timestamp = darwin_device_get_gpu_timestamp,
+   .device_get_suspend_count = darwin_device_get_suspend_count,
+   .device_check_status = darwin_device_check_status,
+   .submitqueue_new = darwin_submitqueue_new,
