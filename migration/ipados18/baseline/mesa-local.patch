+
+static void
+darwin_submit_add_entries(struct tu_device *device, void *_submit,
+                          struct tu_cs_entry *entries, unsigned num_entries)
+{
+   struct tu_darwin_queue_submit *submit = (struct tu_darwin_queue_submit *)_submit;
+   NativeAdrenoAbiSubmitBuffer *cmds = (NativeAdrenoAbiSubmitBuffer *)
+      util_dynarray_grow(&submit->commands, NativeAdrenoAbiSubmitBuffer, num_entries);
+   for (unsigned i = 0; i < num_entries; i++) {
+      cmds[i] = (NativeAdrenoAbiSubmitBuffer) {
+         .handle = entries[i].bo->darwin_handle,
+         .iova = entries[i].bo->iova + entries[i].offset,
+         .bytes = entries[i].size,
+      };
+   }
+}
+
+static void
+darwin_submit_add_bind(struct tu_device *device, void *_submit,
+                       struct tu_sparse_vma *vma, uint64_t vma_offset,
+                       struct tu_bo *bo, uint64_t bo_offset, uint64_t size)
+{
+   UNREACHABLE("sparse binding is not supported by the NativeAdreno kernel client");
+}
+
+/* ---- synchronization: a sync is either signaled, unsignaled, or pending on one kernel fence ---- */
+
+enum darwin_sync_state {
+   DARWIN_SYNC_UNSIGNALED,
+   DARWIN_SYNC_SIGNALED,
+   DARWIN_SYNC_FENCE,
+};
+
+struct vk_darwin_sync {
+   struct vk_sync vk;
+   enum darwin_sync_state state;
+   uint32_t fence;
+};
+
+static VkResult
+vk_darwin_sync_init(struct vk_device *device, struct vk_sync *sync, uint64_t initial_value)
+{
+   struct vk_darwin_sync *s = container_of(sync, struct vk_darwin_sync, vk);
+   s->state = initial_value ? DARWIN_SYNC_SIGNALED : DARWIN_SYNC_UNSIGNALED;
+   s->fence = 0;
+   return VK_SUCCESS;
+}
+
+static void
+vk_darwin_sync_finish(struct vk_device *device, struct vk_sync *sync)
+{
+}
+
+static VkResult
+vk_darwin_sync_reset(struct vk_device *device, struct vk_sync *sync)
+{
+   struct vk_darwin_sync *s = container_of(sync, struct vk_darwin_sync, vk);
+   s->state = DARWIN_SYNC_UNSIGNALED;
+   s->fence = 0;
+   return VK_SUCCESS;
+}
+
+static VkResult
+vk_darwin_sync_move(struct vk_device *device, struct vk_sync *dst, struct vk_sync *src)
+{
+   struct vk_darwin_sync *d = container_of(dst, struct vk_darwin_sync, vk);
+   struct vk_darwin_sync *s = container_of(src, struct vk_darwin_sync, vk);
+   d->state = s->state;
+   d->fence = s->fence;
+   s->state = DARWIN_SYNC_UNSIGNALED;
+   s->fence = 0;
+   return VK_SUCCESS;
+}
+
+static VkResult
+darwin_sync_wait(struct tu_device *device, struct vk_darwin_sync *s, uint64_t abs_timeout_ns)
+{
+   if (s->state == DARWIN_SYNC_UNSIGNALED) {
+      /* Wait for the sync to resolve to a submission first (no wait-before-signal support in the kernel). */
+      if (abs_timeout_ns == 0)
+         return VK_TIMEOUT;
+
+      pthread_mutex_lock(&device->submit_mutex);
+      /* os_time_get_nano() is monotonic but Darwin condition variables wait on the realtime clock. */
+      struct timespec abstime;
+      {
+         uint64_t now = os_time_get_nano();
+         uint64_t relative = abs_timeout_ns > now ? abs_timeout_ns - now : 0;
+         clock_gettime(CLOCK_REALTIME, &abstime);
+         uint64_t nsec = (uint64_t)abstime.tv_nsec + relative % 1000000000ull;
+         abstime.tv_sec += relative / 1000000000ull + nsec / 1000000000ull;
+         abstime.tv_nsec = nsec % 1000000000ull;
+      }
+      while (s->state == DARWIN_SYNC_UNSIGNALED) {
+         int ret;
+         if (abs_timeout_ns == UINT64_MAX)
+            ret = pthread_cond_wait(&device->timeline_cond, &device->submit_mutex);
+         else
+            ret = pthread_cond_timedwait(&device->timeline_cond, &device->submit_mutex, &abstime);
+         if (ret != 0) {
+            assert(ret == ETIMEDOUT);
+            pthread_mutex_unlock(&device->submit_mutex);
+            return VK_TIMEOUT;
+         }
+      }
+      pthread_mutex_unlock(&device->submit_mutex);
+   }
+
+   switch (s->state) {
+   case DARWIN_SYNC_SIGNALED:
+      return VK_SUCCESS;
+   case DARWIN_SYNC_FENCE:
+      return dw_wait_fence_locked_free(device, s->fence, abs_timeout_ns);
+   default:
+      return VK_TIMEOUT;
+   }
+}
+
+static VkResult
+vk_darwin_sync_wait(struct vk_device *_device, struct vk_sync *sync, uint64_t wait_value,
+                    enum vk_sync_wait_flags wait_flags, uint64_t abs_timeout_ns)
+{
+   struct tu_device *device = container_of(_device, struct tu_device, vk);
+   struct vk_darwin_sync *s = container_of(sync, struct vk_darwin_sync, vk);
+
+   if (wait_flags & VK_SYNC_WAIT_PENDING)
+      return VK_SUCCESS;
+
+   return darwin_sync_wait(device, s, abs_timeout_ns);
+}
+
+static VkResult
+vk_darwin_sync_wait_many(struct vk_device *_device, uint32_t wait_count,
+                         const struct vk_sync_wait *waits,
+                         enum vk_sync_wait_flags wait_flags, uint64_t abs_timeout_ns)
+{
+   struct tu_device *device = container_of(_device, struct tu_device, vk);
+
+   if (wait_flags & VK_SYNC_WAIT_PENDING)
+      return VK_SUCCESS;
+
+   if (wait_flags & VK_SYNC_WAIT_ANY) {
+      /* Poll every sync in turn until one is done or the deadline passes. */
+      for (;;) {
+         for (uint32_t i = 0; i < wait_count; i++) {
+            struct vk_darwin_sync *s = container_of(waits[i].sync, struct vk_darwin_sync, vk);
+            if (darwin_sync_wait(device, s, 0) == VK_SUCCESS ||
+                (s->state == DARWIN_SYNC_FENCE &&
+                 dw_wait_fence_locked_free(device, s->fence, 0) == VK_SUCCESS))
+               return VK_SUCCESS;
+         }
+         if (abs_timeout_ns != UINT64_MAX && os_time_get_nano() >= abs_timeout_ns)
+            return VK_TIMEOUT;
+         usleep(200);
+      }
+   }
+
+   for (uint32_t i = 0; i < wait_count; i++) {
+      struct vk_darwin_sync *s = container_of(waits[i].sync, struct vk_darwin_sync, vk);
+      VkResult result = darwin_sync_wait(device, s, abs_timeout_ns);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+   return VK_SUCCESS;
+}
+
+const struct vk_sync_type vk_darwin_sync_type = {
+   .size = sizeof(struct vk_darwin_sync),
+   .features = (enum vk_sync_features)
+               (VK_SYNC_FEATURE_BINARY |
+                VK_SYNC_FEATURE_GPU_WAIT |
+                VK_SYNC_FEATURE_GPU_MULTI_WAIT |
+                VK_SYNC_FEATURE_CPU_WAIT |
+                VK_SYNC_FEATURE_CPU_RESET |
+                VK_SYNC_FEATURE_WAIT_ANY |
+                VK_SYNC_FEATURE_WAIT_PENDING),
+   .init = vk_darwin_sync_init,
+   .finish = vk_darwin_sync_finish,
+   .reset = vk_darwin_sync_reset,
+   .move = vk_darwin_sync_move,
+   .wait = vk_darwin_sync_wait,
+   .wait_many = vk_darwin_sync_wait_many,
+};
+
+static void
+darwin_note_fence(uint32_t fence)
+{
+   if (dw.inflight_count == 8) {
+      memmove(dw.inflight, dw.inflight + 1, 7 * sizeof(dw.inflight[0]));
+      dw.inflight_count = 7;
+   }
+   dw.inflight[dw.inflight_count++] = fence;
+   dw.last_fence = fence;
+}
+
+/* One kernel submission of up to NativeAdrenoAbiMaxBuffers indirect buffers; waits for the oldest job when all eight kernel job slots
+ * are taken. */
+static VkResult
+darwin_submit_chunk(struct tu_queue *queue, const NativeAdrenoAbiSubmitBuffer *entries,
+                    unsigned count, uint32_t *fence)
+{
+   struct tu_device *dev = queue->device;
+   NativeAdrenoAbiSubmit req = {};
+   req.buffer_count = count;
+   req.queue = 0;
+   for (unsigned i = 0; i < count; i++)
+      req.buffers[i] = entries[i];
+
+   for (unsigned attempt = 0; attempt < 64; attempt++) {
+      NativeAdrenoAbiSubmitReply reply = {};
+      kern_return_t kr = dw_call(NativeAdrenoMethodSubmit, &req, sizeof(req), &reply, sizeof(reply));
+      if (kr == KERN_SUCCESS) {
+         *fence = (uint32_t)reply.fence;
+         return VK_SUCCESS;
+      }
+      if (kr != kIOReturnBusy)
+         return vk_device_set_lost(&dev->vk, "submit failed: 0x%x", kr);
+
+      pthread_mutex_lock(&dw.lock);
+      uint32_t oldest = dw.inflight_count ? dw.inflight[0] : 0;
+      pthread_mutex_unlock(&dw.lock);
+      if (!oldest)
+         usleep(100);
+      else if (dw_wait_fence_locked_free(dev, oldest, os_time_get_nano() + 5000000000ull) != VK_SUCCESS)
+         return vk_device_set_lost(&dev->vk, "submit: GPU did not retire a job");
+   }
+   return vk_device_set_lost(&dev->vk, "submit: no free job slot");
+}
+
+static VkResult
+darwin_queue_submit(struct tu_queue *queue, void *_submit,
+                    struct vk_sync_wait *waits, uint32_t wait_count,
+                    struct vk_sync_signal *signals, uint32_t signal_count,
+                    struct tu_u_trace_submission_data *u_trace_submission_data)
+{
+   struct tu_darwin_queue_submit *submit = (struct tu_darwin_queue_submit *)_submit;
+   struct tu_device *dev = queue->device;
+
+   /* The kernel client has one ring and no GPU-side waits: wait on the CPU before submitting. */
+   for (uint32_t i = 0; i < wait_count; i++) {
+      struct vk_darwin_sync *s = container_of(waits[i].sync, struct vk_darwin_sync, vk);
+      VkResult result = darwin_sync_wait(dev, s, UINT64_MAX);
+      if (result != VK_SUCCESS)
+         return vk_device_set_lost(&dev->vk, "wait before submit failed");
+   }
+
+   uint32_t fence = 0;
+   const unsigned total = util_dynarray_num_elements(&submit->commands, NativeAdrenoAbiSubmitBuffer);
+   if (total) {
+      const NativeAdrenoAbiSubmitBuffer *all =
+         util_dynarray_element(&submit->commands, NativeAdrenoAbiSubmitBuffer, 0);
+      for (unsigned at = 0; at < total; at += NativeAdrenoAbiMaxBuffers) {
+         unsigned count = MIN2(total - at, (unsigned)NativeAdrenoAbiMaxBuffers);
+         uint32_t chunk_fence = 0;
+         VkResult result = darwin_submit_chunk(queue, all + at, count, &chunk_fence);
+         if (result != VK_SUCCESS)
+            return result;
+         pthread_mutex_lock(&dw.lock);
+         darwin_note_fence(chunk_fence);
+         pthread_mutex_unlock(&dw.lock);
+         fence = chunk_fence;
+      }
+      p_atomic_set(&queue->fence, fence);
+   } else {
+      /* Nothing to run: the signals resolve with the last earlier submission. */
+      fence = p_atomic_read(&queue->fence) > 0 ? (uint32_t)p_atomic_read(&queue->fence) : 0;
+   }
+
+   for (uint32_t i = 0; i < signal_count; i++) {
+      struct vk_darwin_sync *s = container_of(signals[i].sync, struct vk_darwin_sync, vk);
+      s->fence = fence;
+      s->state = fence ? DARWIN_SYNC_FENCE : DARWIN_SYNC_SIGNALED;
+   }
+
+   if (u_trace_submission_data)
+      u_trace_submission_data->gpu_ts_offset = 0;
+   return VK_SUCCESS;
+}
+
+/* ---- device ---- */
+
+static VkResult
+darwin_device_init(struct tu_device *dev)
+{
+   dev->fd = -1;
+   /* The enumeration probe closed its connection; take the single slot for this device. */
+   if (!dw.open) {
+      VkResult result = dw_open_connection(dev->physical_device->instance);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)
+      vk_zalloc(&dev->vk.alloc, sizeof(*retire), 8, VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (!retire) {
+      dw_close_connection();
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+   if (pthread_mutex_init(&retire->lock, NULL)) {
+      vk_free(&dev->vk.alloc, retire);
+      dw_close_connection();
+      return vk_error(dev, VK_ERROR_INITIALIZATION_FAILED);
+   }
+   dev->darwin_retire = retire;
+   return VK_SUCCESS;
+}
+
+static void
+darwin_device_finish(struct tu_device *dev)
+{
+   /* Closing the connection makes the kernel drain the GPU and free every object this client created. */
+   dw_close_connection();
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   if (retire) {
+      /* Some CreateDevice failure paths already destroyed the VMA heap/mutex.
+       * Never return ranges here: they are either gone or about to be destroyed. */
+      if (debug_get_bool_option("TU_DARWIN_RETIRE_TRACE", false))
+         mesa_logi("darwin BO retirement: enqueued=%llu reaped=%llu pending-at-close=%u pressure=%llu",
+                   (unsigned long long)retire->enqueued, (unsigned long long)retire->reaped,
+                   retire->count, (unsigned long long)retire->pressure_waits);
+      pthread_mutex_destroy(&retire->lock);
+      vk_free(&dev->vk.alloc, retire);
+      dev->darwin_retire = NULL;
+   }
+}
+
+static int
+darwin_device_get_gpu_timestamp(struct tu_device *dev, uint64_t *ts)
+{
+   NativeAdrenoAbiTimestamp reply = {};
+   if (dw_call(NativeAdrenoMethodGetTimestamp, NULL, 0, &reply, sizeof(reply)) != KERN_SUCCESS)
+      return -1;
+   *ts = reply.ticks;
+   return 0;
+}
+
+static int
+darwin_device_get_suspend_count(struct tu_device *dev, uint64_t *suspend_count)
+{
+   NativeAdrenoAbiStatus reply = {};
+   if (dw_call(NativeAdrenoMethodGetStatus, NULL, 0, &reply, sizeof(reply)) != KERN_SUCCESS)
+      *suspend_count = 0;
+   else
+      *suspend_count = reply.suspends;
+   return 0;
+}
+
+static VkResult
+darwin_device_check_status(struct tu_device *device)
+{
+   NativeAdrenoAbiStatus reply = {};
+   kern_return_t kr = dw_call(NativeAdrenoMethodGetStatus, NULL, 0, &reply, sizeof(reply));
+   if (kr == kIOReturnUnsupported)
+      return VK_SUCCESS; /* counters not attached in this kernel */
+   if (kr != KERN_SUCCESS)
+      return vk_device_set_lost(&device->vk, "error getting GPU status: 0x%x", kr);
+   if (reply.faults != device->fault_count) {
+      device->fault_count = reply.faults;
+      return vk_device_set_lost(&device->vk, "GPU faulted or hung");
+   }
+   return VK_SUCCESS;
+}
