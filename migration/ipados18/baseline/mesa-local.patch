diff --git a/src/freedreno/vulkan/tu_knl_darwin.cc b/src/freedreno/vulkan/tu_knl_darwin.cc
new file mode 100644
index 0000000..db976f4
--- /dev/null
+++ b/src/freedreno/vulkan/tu_knl_darwin.cc
@@ -0,0 +1,1114 @@
+/*
+ * Native Darwin kernel backend for Turnip: talks to the NativeAdreno IOKit user client (NativeAdrenoABI.h, version 1).
+ * Modelled on tu_knl_kgsl.cc (no libdrm) and tu_knl_drm_msm.cc (the client chooses GPU addresses).
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <errno.h>
+#include <pthread.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <IOKit/IOKitLib.h>
+#include <mach/mach.h>
+
+#include "NativeAdrenoABI.h"
+
+#include "util/os_time.h"
+#include "util/timespec.h"
+#include "util/u_debug.h"
+#include "util/u_vector.h"
+#include "vk_util.h"
+
+#include "tu_cmd_buffer.h"
+#include "tu_cs.h"
+#include "tu_device.h"
+#include "tu_dynamic_rendering.h"
+#include "tu_knl.h"
+#include "tu_queue.h"
+#include "tu_rmv.h"
+
+/* 'NTNL': first word of a tunnelled call, as served by the driver (NativeAdrenoPublish.cpp). */
+#define DW_TUNNEL_MAGIC 0x4e544e4cu
+
+/* One GPU per process: the kernel service has a single connection slot, so the connection and the fence bookkeeping are
+ * process state rather than per tu_device state. */
+static struct {
+   io_connect_t conn;
+   bool open;
+   pthread_mutex_t lock;
+   /* Fences of the submissions still possibly in flight, oldest first (the kernel keeps at most eight jobs). */
+   uint32_t inflight[8];
+   unsigned inflight_count;
+   /* Transport. On the tablet a sandboxed process (the Metal plugin inside SpringBoard) reaches the driver through the AGX accelerator
+    * service with open type 0x4147, and the sandbox profile decides which external-method selector numbers are admitted, so every ABI
+    * method travels as {magic, method, payload} through one admitted selector (the same tunnel the plugin's own test uses). Direct
+    * selectors (selector = ABI method) stay available for an unrestricted process that opens NativeAdrenoGpuPublished. */
+   bool tunnel;
+   uint32_t selector;
+   uint32_t last_fence;
+   NativeAdrenoAbiDeviceInfo info;
+   NativeAdrenoAbiParams params;
+} dw = { .lock = PTHREAD_MUTEX_INITIALIZER };
+
+/* Preserve the native handle, CPU view and IOVA until the captured ring fence
+ * actually completed. An unrelated later submission never extends this lease.
+ * The queue is bounded; pressure may wait, but ordinary destruction does not. */
+enum { DARWIN_RETIRED_BOS = 256 };
+struct darwin_retired_bo {
+   uint64_t handle, iova, size;
+   void *mapping;
+   uint32_t token, fence;
+};
+struct darwin_retire_state {
+   pthread_mutex_t lock;
+   struct darwin_retired_bo entries[DARWIN_RETIRED_BOS];
+   unsigned head, count;
+   VkResult failure;
+   uint64_t enqueued, reaped, pressure_waits;
+};
+
+static kern_return_t
+dw_call(uint32_t method, const void *in, size_t in_size, void *out,
+        size_t out_size)
+{
+   size_t out_bytes = out_size;
+   if (!dw.tunnel)
+      return IOConnectCallStructMethod(dw.conn, method, in, in_size, out_size ? out : NULL,
+                                       out_size ? &out_bytes : NULL);
+   uint8_t buffer[8 + sizeof(NativeAdrenoAbiSubmit)];
+   if (in_size > sizeof(NativeAdrenoAbiSubmit))
+      return kIOReturnBadArgument;
+   const uint32_t header[2] = {DW_TUNNEL_MAGIC, method};
+   memcpy(buffer, header, sizeof(header));
+   if (in_size)
+      memcpy(buffer + sizeof(header), in, in_size);
+   return IOConnectCallStructMethod(dw.conn, dw.selector, buffer, sizeof(header) + in_size, out_size ? out : NULL,
+                                    out_size ? &out_bytes : NULL);
+}
+
+/* Finds an admitted selector: the driver answers a tunnel probe (method 0xffffffff) with success for every selector the sandbox lets through. */
+static bool
+dw_probe_selector(void)
+{
+   const uint32_t header[2] = {DW_TUNNEL_MAGIC, 0xffffffffu};
+   for (uint32_t s = 0; s < 256; s++) {
+      if (IOConnectCallStructMethod(dw.conn, s, header, sizeof(header), NULL, NULL) == KERN_SUCCESS) {
+         dw.selector = s;
+         return true;
+      }
+   }
+   return false;
+}
+
+static VkResult
+dw_open_connection(struct tu_instance *instance)
+{
+   /* TU_DARWIN_SERVICE names the IOKit service (default: the AGX accelerator the original Metal discovery finds), TU_DARWIN_OPEN_TYPE its open
+    * type (default 0x4147, the type the driver serves to the plugin). NativeAdrenoGpuPublished with type 0 is the unsandboxed direct form. */
+   const char *service_name = getenv("TU_DARWIN_SERVICE");
+   if (!service_name || !*service_name)
+      service_name = "IOAcceleratorES";
+   const char *type_text = getenv("TU_DARWIN_OPEN_TYPE");
+   uint32_t open_type = type_text && *type_text ? (uint32_t)strtoul(type_text, NULL, 0) : 0x4147u;
+   const bool direct = !strcmp(service_name, "NativeAdrenoGpuPublished");
+   if (direct && !(type_text && *type_text))
+      open_type = 0;
+   io_service_t service = IOServiceGetMatchingService(
+      kIOMainPortDefault, IOServiceMatching(service_name));
+   if (!service)
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+
+   kern_return_t kr = IOServiceOpen(service, mach_task_self(), open_type, &dw.conn);
+   IOObjectRelease(service);
+   if (kr != KERN_SUCCESS) {
+      return vk_startup_errorf(instance, VK_ERROR_INITIALIZATION_FAILED,
+                               "IOServiceOpen(%s, 0x%x) failed: 0x%x", service_name, open_type, kr);
+   }
+   dw.tunnel = !direct;
+   if (dw.tunnel && !dw_probe_selector()) {
+      IOServiceClose(dw.conn);
+      dw.conn = 0;
+      return vk_startup_errorf(instance, VK_ERROR_INITIALIZATION_FAILED, "no external-method selector is admitted for this process");
+   }
+
+   kr = dw_call(NativeAdrenoMethodQuery, NULL, 0, &dw.params, sizeof(dw.params));
+   if (kr == KERN_SUCCESS && dw.params.abi_version != NativeAdrenoAbiVersion)
+      kr = kIOReturnUnsupported;
+   if (kr == KERN_SUCCESS)
+      kr = dw_call(NativeAdrenoMethodGetDeviceInfo, NULL, 0, &dw.info, sizeof(dw.info));
+   if (kr != KERN_SUCCESS) {
+      IOServiceClose(dw.conn);
+      dw.conn = 0;
+      return vk_startup_errorf(instance, VK_ERROR_INITIALIZATION_FAILED,
+                               "NativeAdreno query failed: 0x%x", kr);
+   }
+   dw.open = true;
+   dw.inflight_count = 0;
+   dw.last_fence = 0;
+   return VK_SUCCESS;
+}
+
+static void
+dw_close_connection(void)
+{
+   if (dw.open) {
+      IOServiceClose(dw.conn);
+      dw.conn = 0;
+      dw.open = false;
+   }
+}
+
+static VkResult
+dw_status_to_vk(struct tu_device *dev, kern_return_t kr, const char *what)
+{
+   if (kr == KERN_SUCCESS)
+      return VK_SUCCESS;
+   if (kr == kIOReturnTimeout)
+      return VK_TIMEOUT;
+   return vk_device_set_lost(&dev->vk, "%s failed: 0x%x", what, kr);
+}
+
+/* Waits for a fence in short kernel waits so the connection lock is never held for long. */
+static VkResult
+dw_wait_fence_raw(struct tu_device *dev, uint32_t fence, uint64_t abs_timeout_ns)
+{
+   for (;;) {
+      uint64_t now = os_time_get_nano();
+      uint64_t slice = 1000000; /* 1 ms */
+      if (abs_timeout_ns != UINT64_MAX && abs_timeout_ns <= now)
+         slice = 0;
+      NativeAdrenoAbiWaitFence req = {.fence = fence, .timeout_ns = slice};
+      kern_return_t kr = dw_call(NativeAdrenoMethodWaitFence, &req, sizeof(req), NULL, 0);
+      if (kr == KERN_SUCCESS)
+         return VK_SUCCESS;
+      if (kr != kIOReturnTimeout)
+         return dw_status_to_vk(dev, kr, "wait fence");
+      if (slice == 0)
+         return VK_TIMEOUT;
+      if (abs_timeout_ns != UINT64_MAX && os_time_get_nano() >= abs_timeout_ns)
+         return VK_TIMEOUT;
+   }
+}
+
+static VkResult darwin_collect_retired(struct tu_device *dev);
+
+static VkResult
+dw_wait_fence_locked_free(struct tu_device *dev, uint32_t fence, uint64_t abs_timeout_ns)
+{
+   VkResult result = dw_wait_fence_raw(dev, fence, abs_timeout_ns);
+   /* Fence observation is also a retirement opportunity, so a quiet application
+    * need not allocate another BO to release completed deferred storage. */
+   return result == VK_SUCCESS ? darwin_collect_retired(dev) : result;
+}
+
+static VkResult
+darwin_queue_wait_fence(struct tu_queue *queue, uint32_t fence, uint64_t timeout_ns)
+{
+   uint64_t abs = timeout_ns == UINT64_MAX ? UINT64_MAX : os_time_get_nano() + timeout_ns;
+   return dw_wait_fence_locked_free(queue->device, fence, abs);
+}
