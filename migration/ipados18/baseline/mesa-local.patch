+VkResult
+tu_knl_darwin_load(struct tu_instance *instance)
+{
+   if (instance->vk.enabled_extensions.KHR_display) {
+      return vk_errorf(instance, VK_ERROR_INITIALIZATION_FAILED, "I can't KHR_display");
+   }
+
+   VkResult result = dw_open_connection(instance);
+   if (result != VK_SUCCESS) {
+      if (result != VK_ERROR_INCOMPATIBLE_DRIVER)
+         mesa_loge("NativeAdreno: could not open the kernel client (%d)", result);
+      return result;
+   }
+
+   struct tu_physical_device *device = (struct tu_physical_device *)
+      vk_zalloc(&instance->vk.alloc, sizeof(*device), 8, VK_SYSTEM_ALLOCATION_SCOPE_INSTANCE);
+   if (!device) {
+      dw_close_connection();
+      return vk_error(instance, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+
+   const NativeAdrenoAbiDeviceInfo *info = &dw.info;
+
+   device->instance = instance;
+   device->local_fd = -1;
+   device->master_fd = -1;
+   device->kgsl_dma_fd = -1;
+   snprintf(device->fd_path, sizeof(device->fd_path), "NativeAdrenoGpu");
+
+   device->dev_id.chip_id = info->chip_id;
+   device->dev_id.gpu_id = ((info->chip_id >> 24) & 0xff) * 100 +
+                           ((info->chip_id >> 16) & 0xff) * 10 +
+                           ((info->chip_id >> 8) & 0xff);
+   /* The chip id decodes to the Adreno family only for kgsl-style ids; the freedreno device table matches this chip by
+    * chip id (0x43050a01) alone. */
+   if (info->chip_id == 0x43050a01)
+      device->dev_id.gpu_id = 740;
+   device->gmem_size = debug_get_num_option("TU_GMEM", info->gmem_bytes);
+   device->gmem_base = info->gmem_base;
+   device->uche_trap_base = info->uche_trap_base;
+
+   device->has_set_iova = !!(info->flags & NativeAdrenoDeviceClientIova);
+   device->va_start = info->va_start;
+   device->va_size = info->va_size;
+   device->has_lazy_bos = false;
+   device->has_sparse = false;
+   device->has_sparse_prr = false;
+   device->has_raytracing = false;
+   device->has_preemption = false;
+   device->is_perf_cntr_selectable = false;
+   device->has_cached_coherent_memory = !!(info->flags & NativeAdrenoDeviceCachedCoherent);
+   device->has_host_import = !!(dw.params.flags & NativeAdrenoParamsHostImport);
+   device->submitqueue_priority_count = 1;
+
+   device->ubwc_config.highest_bank_bit = info->highest_bank_bit;
+   device->ubwc_config.bank_swizzle_levels = info->ubwc_swizzle;
+   device->ubwc_config.macrotile_mode =
+      info->macrotile_mode ? FDL_MACROTILE_8_CHANNEL : FDL_MACROTILE_4_CHANNEL;
+
+   device->timeline_type = vk_sync_timeline_get_type(&vk_darwin_sync_type);
+   device->sync_types[0] = &vk_darwin_sync_type;
+   device->sync_types[1] = &device->timeline_type.sync;
+   device->sync_types[2] = NULL;
+
+   /* All BOs must fit this connection's scoped GPU IOVA window. System RAM
+    * is shared backing, not extra addressable device-local heap capacity.
+    * Reporting the whole RAM budget made CA's caches exceed the 170 MiB
+    * non-render-server aperture even when physical pages were available. */
+   device->heap.size = MIN2(tu_get_system_heap_size(device), info->va_size);
+   device->heap.used = 0u;
+   device->heap.flags = VK_MEMORY_HEAP_DEVICE_LOCAL_BIT;
+
+   instance->knl = &darwin_knl_funcs;
+
+   result = tu_physical_device_init(device, instance);
+   /* The enumeration probe only needed the facts; the device takes the slot again in device_init. */
+   dw_close_connection();
+   if (result != VK_SUCCESS) {
+      mesa_loge("NativeAdreno: tu_physical_device_init failed (%d)", result);
+      vk_free(&instance->vk.alloc, device);
+      return result;
+   }
+
+   list_addtail(&device->vk.link, &instance->vk.physical_devices.list);
+   return VK_SUCCESS;
+}
