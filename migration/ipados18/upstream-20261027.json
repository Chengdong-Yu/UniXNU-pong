  "merged": [
    {
      "area": "GPU VM",
      "changes": [
        "16384 BO slots and handle index",
        "free/high slot hints and alias-exclusive mapping",
        "keep Pong 32-bit IOVA/client windows and physical firmware resources"
      ]
    },
    {
      "area": "SMMU",
      "changes": [
        "leaf range invalidation on small unmaps",
        "ASID invalidation for large unmaps",
        "preserve Pong polled_faults ABI",
        "avoid per-submit TLB flush"
      ]
    },
    {
      "area": "Metal",
      "changes": [
        "return failing encoder object for rejected runtime encoder instead of null IMP in RenderBox",
        "retain 22H374 device extent 600 and responsible task uint32 ABI"
      ]
    },
    {
      "area": "Darwin24",
      "changes": [
        "adapt work interval instance ops 6/7/8 to no performance-controller sink",
        "preserve existing Cryptex namespace and 4K user/kernel pages with 16K signature-block conversion"
      ]
    },
    {
      "area": "RAM",
      "changes": [
        "DarwinBoot AllocatePages ownership list",
        "dense PA/page indices for separate physical banks",
        "no memory holes or reserved firmware/DSP/GOP/ramoops pages enter free lists",
        "failed extra bank claims remain unowned instead of breaking primary boot"
      ]
    },
    {
      "area": "Display",
      "changes": [
        "1080x2412/4320 stride",
        "60/90/120 requested policy",
        "retain completed frame on fence timeout",
        "GPU worker stays eligible between waits"
      ]
    },
    {
      "area": "Wi-Fi",
      "changes": [
        "reset SM8475 core and PHY before vendor sequence",
        "remove nonexistent PIPE reset after PHY programming"
      ]
    },
    {
      "area": "Brightness",
      "changes": [
        "Pong NT37705 DCS FIFO writes and BTA readback",
        "CoreBrightness brightness/FadePeriod service",
        "Darwin24 metaclass getter compiled by name; no vtable slot patch",
        "link/init independently of Wi-Fi",
        "actual MiniIOMobileFramebuffer.cpo compile flag and mode rebuild"
      ]
    }
  ],
  "not_applied": [
    {
      "change": "default Darwin23/iPadOS17 profile",
      "reason": "keep Darwin24/22H374 ABI and pinned Apple components"
    },
    {
      "change": "Sheng dual DSI and direct DPU scanout",
      "reason": "SM8550 register/CTL/SSPP arrangement differs from single DSI0 Pong"
    },
    {
      "change": "Sheng KTZ8866 I2C brightness",
      "reason": "Pong OLED brightness uses DCS"
