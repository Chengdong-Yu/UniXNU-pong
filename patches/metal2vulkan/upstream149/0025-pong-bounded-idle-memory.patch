+// Optional board budget for idle memory only. The upstream default remains
+// unchanged when unset; live resources and submitted DMA are never reclaimed.
+fn board_spare_limit() -> Option<u64> {
+    static LIMIT: std::sync::OnceLock<Option<u64>> = std::sync::OnceLock::new();
+    *LIMIT.get_or_init(|| {
+        std::env::var("METAL2VULKAN_SPARE_IMAGE_MIB").ok()?
+            .parse::<u64>().ok()?.checked_mul(1 << 20)
+    })
+}
