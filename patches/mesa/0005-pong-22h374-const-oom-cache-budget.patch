+   // ABI1 uses disjoint finite VA windows. A ten-second unbounded BO cache
+   // plus the translator's spare images can retain most of a client's VA
+   // until the next allocation stalls to flush everything. Bound only the
+   // already-retired cache; in-flight ownership and fences stay unchanged.
+   static const int cache_mib = debug_get_num_option("TU_DARWIN_BO_CACHE_MIB", -1);
+   if (cache_mib >= 0) {
+      const uint64_t budget = MIN2((uint64_t)MIN2(cache_mib, 1024) << 20, dw.info.va_size / 4);
+      if (bo->size > budget || retire->cache_bytes > budget - bo->size)
+         return false;
+   }
    if (retire->cache_count == retire->cache_capacity) {
       const unsigned capacity = retire->cache_capacity ? retire->cache_capacity * 2 : 64;
       struct darwin_cached_bo *cache = (struct darwin_cached_bo *)realloc(retire->cache, capacity * sizeof(*cache));
