+/* GMEM holds a colour in the byte order its render target writes it in: a linear image's MRT swap (WXYZ for BGRA) is already applied
+ * there, as system memory rendering writes it. A load or a store therefore moves the bytes as they are, with the identity swap on the
+ * memory side too; the image's own swap on top exchanged red and blue against what system memory rendering writes (a frame mixing
+ * both modes: the wallpaper of the lock screen 51 % exchanged in i-batch, centre redrawn in system memory correct). A mutable tiled
+ * image (MUTABLEEN) keeps its swap.
+ */
+static inline uint32_t
+tu_gmem_transfer_swap_fixup(uint32_t info, uint32_t swap_mask, uint32_t identity, bool mutable_view)
+{
+   return mutable_view ? info : ((info & ~swap_mask) | identity);
+}
