+/* Telemetry for the copies that need a row-by-row path (tu_copy_row_stats). [0] buffer to image copies, [1] those split into one blit per row, [2] their
+ * rows, [3] image to buffer copies, [4] those split per row, [5] their rows, [6] rows of the largest split copy, [7] its pitch in bytes,
+ * [8] its width | height << 32, [9] its VkFormat. A copy is counted per layer. */
+static uint64_t tu_copy_row_counters[16];
+static void
+tu_note_copy_rows(unsigned kind, bool split, uint32_t rows, uint32_t pitch, uint32_t width, uint32_t height, uint32_t format)
+{
+   uint64_t *c = tu_copy_row_counters + kind * 3;
+   __atomic_fetch_add(&c[0], 1, __ATOMIC_RELAXED);
+   if (!split)
+      return;
+   __atomic_fetch_add(&c[1], 1, __ATOMIC_RELAXED);
+   __atomic_fetch_add(&c[2], rows, __ATOMIC_RELAXED);
+   if (rows > tu_copy_row_counters[6]) {
+      tu_copy_row_counters[6] = rows;
+      tu_copy_row_counters[7] = pitch;
+      tu_copy_row_counters[8] = (uint64_t)height << 32 | width;
+      tu_copy_row_counters[9] = format;
+   }
+}
+extern "C" __attribute__((visibility("default"))) void tu_copy_row_stats(uint64_t out[16]);
+extern "C" void
+tu_copy_row_stats(uint64_t out[16])
+{
+   for (unsigned i = 0; i < 16; i++)
+      out[i] = __atomic_load_n(&tu_copy_row_counters[i], __ATOMIC_RELAXED);
+}
