+	/* Darwin 24 launchd requests a real system-proxy persona even in the
+	 * restore boot policy, where Apple's usermanagerd boot task is skipped.
+	 * It filters persona_info.persona_uid, not the allocated persona ID:
+	 * the system domain requests (uid_t)-1, user/501 requests 501.
+	 * KAUTH_UID_NONE is -101 in Darwin 24 and does not match that request.
+	 * Keep native refcount, adoption and credential semantics for both. */
+	static const struct { const char *name; uid_t uid; } domains[] = {
+		{ "pong-sys", (uid_t)-1 },
+		{ "pong-mobile", 501 },
+	};
+	for (unsigned i = 0; i < sizeof(domains) / sizeof(domains[0]); i++) {
+		struct persona *existing = NULL;
+		size_t count = 1;
+		if (persona_find(domains[i].name, PERSONA_ID_NONE, &existing, &count) == 0) {
+			if (existing) persona_put(existing);
+			continue;
+		}
+		int error = 0;
+		struct persona *proxy = persona_alloc(PERSONA_ID_NONE, domains[i].name,
+		    PERSONA_SYSTEM_PROXY, NULL, domains[i].uid, &error);
+		if (!proxy) {
+			printf("Pong bootstrap: proxy uid=%d allocation failed %d\n", (int)domains[i].uid, error);
+			continue;
+		}
+		error = persona_init_begin(proxy);
+		persona_init_end(proxy, error);
+		if (error) {
+			persona_put(proxy);
+			printf("Pong bootstrap: proxy uid=%d initialization failed %d\n", (int)domains[i].uid, error);
+			continue;
+		}
+		/* Registry retains the initial reference, as kpersona_alloc_syscall. */
+		printf("Pong bootstrap: system-proxy persona ready id=%u uid=%d\n",
+		    proxy->pna_id, (int)domains[i].uid);
+	}
+}
