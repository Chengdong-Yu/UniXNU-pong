+        for (unsigned j = 0; j < i; j++) {
+            uint64_t other = wire[4 + j * 2], bytes = wire[5 + j * 2];
+            if (start < other + bytes && other < start + size) return;
+        }
+        total += size;
+    }
+    if (wire[2] != total) return;
+    for (unsigned i = 1; i < wire[1]; i++) {
+        uint64_t start = wire[4 + i * 2], size = wire[5 + i * 2];
+        pong_ram_ranges[i] = (struct pong_ram_range){start, start + size, pong_ram_bytes >> PAGE_SHIFT};
+        pong_ram_bytes += size;
+    }
