+
+OSDefineMetaClassAndStructors(IOSurfaceRootUserClient, IOUserClient);
+
+bool
+IOSurfaceRootUserClient::initWithTask(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) {
+		return false;
+	}
+	fTask = owningTask;
+	return true;
+}
+
+bool
+IOSurfaceRootUserClient::start(IOService * provider)
+{
+	if (!IOUserClient::start(provider)) {
+		return false;
+	}
+	bzero(fTraps, sizeof(fTraps));
+	fTraps[kSurfaceTrapIncrementUseCount].func = (IOTrap) & IOSurfaceRootUserClient::trapIncrementUseCount;
+	fTraps[kSurfaceTrapDecrementUseCount].func = (IOTrap) & IOSurfaceRootUserClient::trapDecrementUseCount;
+	fTraps[kSurfaceTrapLock].func = (IOTrap) & IOSurfaceRootUserClient::trapLock;
+	fTraps[kSurfaceTrapUnlock].func = (IOTrap) & IOSurfaceRootUserClient::trapUnlock;
+	fTraps[kSurfaceTrapDetach].func = (IOTrap) & IOSurfaceRootUserClient::trapDetach;
+	fTraps[kSurfaceTrapRelease].func = (IOTrap) & IOSurfaceRootUserClient::trapRelease;
+	fTraps[kSurfaceTrapRemoveCoreVideoBridgedValues].func = (IOTrap) & IOSurfaceRootUserClient::trapRemoveCoreVideoBridgedValues;
+	fTraps[kSurfaceTrapRemoveBulkAttachments].func = (IOTrap) & IOSurfaceRootUserClient::trapRemoveBulkAttachments;
+	for (unsigned i = 0; i < kSurfaceTrapCount; i++) {
+		fTraps[i].object = this;
+	}
+	return true;
+}
+
+IOReturn
+IOSurfaceRootUserClient::clientClose(void)
+{
+	IOLockLock(gSurfaceLock);
+	while (fRefCount != 0) {
+		dropRef(&fRefs[fRefCount - 1]);
+	}
+	IOLockUnlock(gSurfaceLock);
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+void
+IOSurfaceRootUserClient::free(void)
+{
+	if (fRefs != NULL) {
+		if (gSurfaceLock != NULL) {
+			IOLockLock(gSurfaceLock);
+			while (fRefCount != 0) {
+				dropRef(&fRefs[fRefCount - 1]);
+			}
+			IOLockUnlock(gSurfaceLock);
+		}
+		IODelete(fRefs, struct minisurf_client_ref, fRefCapacity);
+		fRefs = NULL;
+	}
+	OSSafeReleaseNULL(fCoreVideoKeys);
+	IOUserClient::free();
+}
+
+/* All three with the lock held. */
+struct minisurf_client_ref *
+IOSurfaceRootUserClient::findRef(uint32_t sid, bool detached)
+{
+	for (uint32_t i = 0; i < fRefCount; i++) {
+		if (fRefs[i].surface->sid == sid && fRefs[i].detached == detached) {
+			return &fRefs[i];
+		}
+	}
+	return NULL;
+}
+
+struct minisurf_client_ref *
+IOSurfaceRootUserClient::addRef(MiniIOSurface * surface)
+{
+	struct minisurf_client_ref * ref;
+	IOMemoryMap * map, *pixelMap = NULL;
+
+	if (fRefCount == fRefCapacity) {
+		if (fRefCapacity >= MINISURF_TABLE_SIZE) {
+			return NULL;
+		}
+		uint32_t capacity = fRefCapacity ? fRefCapacity * 2 : 16;
+		struct minisurf_client_ref * refs = IONew(struct minisurf_client_ref, capacity);
+
+		if (refs == NULL) {
+			return NULL;
+		}
+		if (fRefs != NULL) {
+			memcpy(refs, fRefs, fRefCount * sizeof(*refs));
+			IODelete(fRefs, struct minisurf_client_ref, fRefCapacity);
+		}
+		fRefs = refs;
+		fRefCapacity = capacity;
+	}
+	map = surface->memory->createMappingInTask(fTask, 0, kIOMapAnywhere);
+	if (map == NULL) {
+		IOLog("MiniIOSurface: cannot map surface %u (%u bytes) into the client\n", surface->sid, surface->info.allocSize);
+		return NULL;
+	}
+	if (surface->client != NULL && surface->clientTask != fTask) {
+		IOOptionBits pixelOptions = kIOMapAnywhere;
+		if (surface->client->getDirection() == kIODirectionOut) {
+			/* A read-only image can be shared for reading. Darwin24 must
+			 * not be asked to create a writable foreign mapping for it. */
+			pixelOptions |= kIOMapReadOnly;
+		}
+		pixelMap = surface->client->createMappingInTask(fTask, 0, pixelOptions);
+		if (pixelMap == NULL) {
+			map->release();
+			return NULL;
+		}
+	}
+	/* Publish a client reference only after both mappings exist. A failed
+	 * foreign-task mapping must never return the owner's virtual address. */
+	ref = &fRefs[fRefCount++];
+	bzero(ref, sizeof(*ref));
+	ref->surface = surface;
+	ref->map = map;
+	ref->pixelMap = pixelMap;
+	surfaceHold(surface);
+	return ref;
+}
+
+void
+IOSurfaceRootUserClient::dropRef(struct minisurf_client_ref * ref)
+{
+	MiniIOSurface * s = ref->surface;
+
+	for (unsigned c = 0; c < 2; c++) {
+		s->useCount[c] -= ref->use[c];
+	}
+	s->shared()->useCount = (uint64_t) s->useCount[1] << 32 | s->useCount[0];
+	OSSafeReleaseNULL(ref->map);
+	OSSafeReleaseNULL(ref->pixelMap);
+	*ref = fRefs[--fRefCount];
+	surfaceUnhold(s);
+}
+
+static uint32_t
+resultSize(const MiniIOSurface * s)
+{
+	uint32_t planes = s->info.planeCount ? s->info.planeCount : 1;
+
+	return (uint32_t) (sizeof(minisurf_result18) + planes * sizeof(minisurf_plane18));
+}
+
+/* Describe the surface to the client. known: it has the surface already, do not build a second view. */
+IOReturn
+IOSurfaceRootUserClient::returnSurface(struct minisurf_client_ref * ref, bool known, IOExternalMethodArguments * args)
+{
+	MiniIOSurface * s = ref->surface;
+	uint32_t size = resultSize(s);
+	minisurf_result18 * r = (minisurf_result18 *) args->structureOutput;
+	mach_vm_address_t address = ref->map->getAddress();
+
+	if (r == NULL || args->structureOutputSize < size) {
+		return kIOReturnBadArgument;
+	}
+	bzero(r, size);
+	const minisurf_result & info = s->info;
+	r->sid = info.sid;
+	r->allocSize = info.allocSize;
+	r->width = info.width;
+	r->height = info.height;
+	r->bytesPerRow = info.bytesPerRow;
+	r->offset = info.offset;
+	r->pixelFormat = info.pixelFormat;
+	r->planeCount = info.planeCount;
+	r->bytesPerElement = info.bytesPerElement;
+	r->elementWidth = info.elementWidth;
+	r->elementHeight = info.elementHeight;
+	r->cacheMode = info.cacheMode;
+	r->lockSeed = info.lockSeed;
+	r->subsampling = info.subsampling;
+	r->prohibitUseCount = info.prohibitUseCount;
+	r->parentID = info.parentID;
+	r->sliceCount = info.sliceCount;
+	r->traceID = info.traceID;
+	r->protectionOptions = info.protectionOptions;
+	minisurf_plane18 * planes = (minisurf_plane18 *)(r + 1);
+	for (uint32_t i = 0; i < (info.planeCount ? info.planeCount : 1); i++) {
+		const minisurf_plane & p = s->planes[i];
+		planes[i].width = p.width;
+		planes[i].height = p.height;
+		planes[i].offset = p.offset;
+		planes[i].bytesPerRow = p.bytesPerRow;
+		planes[i].size = p.size;
+		planes[i].bytesPerElement = p.bytesPerElement;
+		planes[i].elementWidth = p.elementWidth;
+		planes[i].elementHeight = p.elementHeight;
+		planes[i].componentCount = p.componentCount;
+		planes[i].addressFormat = p.addressFormat;
+		memcpy(planes[i].componentBitDepth, p.componentBitDepth, sizeof(p.componentBitDepth));
+		memcpy(planes[i].componentBitOffset, p.componentBitOffset, sizeof(p.componentBitOffset));
+		memcpy(planes[i].componentName, p.componentName, sizeof(p.componentName));
+		memcpy(planes[i].componentType, p.componentType, sizeof(p.componentType));
+		memcpy(planes[i].componentRange, p.componentRange, sizeof(p.componentRange));
+		planes[i].compression = p.compression;
+		memcpy(planes[i].extendedPixels, p.extendedPixels, sizeof(p.extendedPixels));
+	}
+	r->shared = address;
+	r->aux = address + MINISURF_AUX_OFFSET;
+	r->base = known ? ~0ULL : s->client == NULL ? address + PAGE_SIZE :
+	    ref->pixelMap != NULL ? ref->pixelMap->getAddress() : s->clientAddress;
+	args->structureOutputSize = size;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodInit(IOExternalMethodArguments * args)
+{
+	struct {
+		uint32_t allocAlignMask;
+		uint32_t rowAlignMask;
+		uint64_t maxBytesPerRow;
+		uint64_t maxWidth;
+		uint64_t maxHeight;
+		uint16_t reserved;
+		uint16_t version;
+		uint32_t reserved24;
+	} reply;
+
+	static_assert(sizeof(reply) == 0x28, "22H374 init reply");
+	static_assert(offsetof(decltype(reply), version) == 0x22, "22H374 init version");
+	if (args->structureOutput == NULL || args->structureOutputSize < sizeof(reply)) {
+		return kIOReturnBadArgument;
+	}
+	reply.allocAlignMask = (uint32_t) PAGE_MASK;
+	reply.rowAlignMask = MINISURF_ROW_ALIGN - 1;
+	reply.maxBytesPerRow = MINISURF_MAX_DIMENSION * 16;
+	reply.maxWidth = MINISURF_MAX_DIMENSION;
+	reply.maxHeight = MINISURF_MAX_DIMENSION;
+	reply.reserved = 0;
+	reply.version = 1;
+	reply.reserved24 = 0;
+	memcpy(args->structureOutput, &reply, sizeof(reply));
+	args->structureOutputSize = sizeof(reply);
+	return kIOReturnSuccess;
+}
+
+/* The serialized object in a request, or NULL. */
+static OSObject *
+unserialize(const uint8_t * data, size_t size)
+{
+	if (data == NULL || size < 4) {
+		return NULL;
+	}
+	return OSUnserializeXML((const char *) data, size, NULL);
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodCreate(IOExternalMethodArguments * args)
+{
+	IOReturn ret;
+	IOMemoryMap * inMap = NULL;
+	const uint8_t * in = (const uint8_t *) args->structureInput;
+	size_t inSize = args->structureInputSize;
+	OSObject * obj;
+	OSDictionary * props;
+	MiniIOSurface * s;
+	struct minisurf_client_ref * ref;
+	uint64_t began = mach_absolute_time();
+
+	/* 22H374 passes one parent-ID scalar even for an ordinary create (0).
+	 * A child must alias its parent's storage; never substitute a new,
+	 * unrelated allocation while claiming the child operation succeeded. */
+	if (args->scalarInputCount != 1) return kIOReturnBadArgument;
+	if (args->scalarInput[0] != 0) return kIOReturnUnsupported;
+
+	if (args->structureInputDescriptor != NULL) {
+		inMap = args->structureInputDescriptor->map(kIOMapReadOnly);
+		if (inMap == NULL) {
+			return kIOReturnNoMemory;
+		}
+		in = (const uint8_t *) inMap->getVirtualAddress();
+		inSize = inMap->getLength();
+	}
+	obj = unserialize(in, inSize);
+	OSSafeReleaseNULL(inMap);
+	props = OSDynamicCast(OSDictionary, obj);
+	if (props == NULL) {
+		OSSafeReleaseNULL(obj);
+		return kIOReturnBadArgument;
+	}
+	s = surfaceCreate(props, &ret);
+	if (s == NULL) {
+		IOLog("MiniIOSurface: create failed 0x%x: %ux%u format 0x%x alloc %u\n", ret,
+		    dictNumber(props, "IOSurfaceWidth", 0), dictNumber(props, "IOSurfaceHeight", 0),
+		    dictNumber(props, "IOSurfacePixelFormat", 0), dictNumber(props, "IOSurfaceAllocSize", 0));
+		props->release();
+		return ret;
+	}
+	{
+		char procname[32] = "?";
+		static unsigned keysSaid;
+
+		proc_selfname(procname, sizeof(procname));
+		/* what a traced program asks for, key by key (the first few surfaces) */
+		if (gSurfaceTraceOf[0] != 0 && strncmp(procname, gSurfaceTraceOf, strlen(gSurfaceTraceOf)) == 0 && keysSaid++ < 6) {
+			OSCollectionIterator * keys = OSCollectionIterator::withCollection(props);
+			char line[256];
+			size_t used = 0;
+			OSSymbol * key;
+
+			line[0] = 0;
+			while (keys != NULL && (key = OSDynamicCast(OSSymbol, keys->getNextObject())) != NULL && used < sizeof(line)) {
+				OSNumber * n = OSDynamicCast(OSNumber, props->getObject(key));
+
+				used += (size_t) snprintf(line + used, sizeof(line) - used, " %s=%lld", key->getCStringNoCopy(),
+				    n ? (long long) n->unsigned64BitValue() : -1LL);
+			}
+			OSSafeReleaseNULL(keys);
+			traceLine("MiniIOSurface: %s asks for a surface with%s\n", procname, line);
+		}
+	}
+	props->release();
+	{
+		char procname[32] = "?";
+
+		proc_selfname(procname, sizeof(procname));
+		if (gSurfaceTraceOf[0] != 0 && strncmp(procname, gSurfaceTraceOf, strlen(gSurfaceTraceOf)) != 0) {
+			procname[0] = 0;        /* (not one of those asked about: not counted) */
+		}
+		if (procname[0] != 0 && gSurfaceTraced < gSurfaceTrace) {
+			s->traced = gSurfaceTraceOf[0] != 0;
+		}
+	}
+	if (s->traced || (gSurfaceTraceOf[0] == 0 && gSurfaceTraced < gSurfaceTrace)) {
+		char procname[32] = "?";
+
+		gSurfaceTraced++;
+		proc_selfname(procname, sizeof(procname));
+		traceLine("MiniIOSurface: %s[%d] created surface %u: %ux%u '%c%c%c%c', %u bytes per row, %u planes, %u bytes\n",
+		    procname, proc_selfpid(), s->sid, s->info.width, s->info.height, (int) (s->info.pixelFormat >> 24 & 0xff),
+		    (int) (s->info.pixelFormat >> 16 & 0xff), (int) (s->info.pixelFormat >> 8 & 0xff),
+		    (int) (s->info.pixelFormat & 0xff), s->info.bytesPerRow, s->info.planeCount, s->info.allocSize);
+	}
+
+	IOLockLock(gSurfaceLock);
+	ref = addRef(s);
+	ret = ref ? returnSurface(ref, false, args) : kIOReturnNoMemory;
+	if (ref != NULL && ret != kIOReturnSuccess) {
+		dropRef(ref);
+	}
+	surfaceUnhold(s);                       /* the creator's hold; the client's own is in the ref */
+	IOLockUnlock(gSurfaceLock);
+	OSAddAtomic64((SInt64) (mach_absolute_time() - began), (SInt64 *) &gSurfaceMaking);
+	OSIncrementAtomic(&gSurfacesMade);
+	return ret;
+}
+
+/* 22H374 IOSurfaceClientWrapClientImage sends this 32-byte layout. Use the
+ * same validated, pinned client-memory surface as IOSurfaceCreate(Address),
+ * with its actual pixels shared across tasks; no GPU binding is involved. */
+IOReturn
+IOSurfaceRootUserClient::methodWrapClientImage(IOExternalMethodArguments *args)
+{
+	struct {
+		uint64_t address;
+		uint32_t width, height, format, bytesPerElement, bytesPerRow, allocSize;
+	} image;
+	static_assert(sizeof(image) == 32, "22H374 wrapped image request");
+	if (!args->structureInput || args->structureInputSize != sizeof(image))
+		return kIOReturnBadArgument;
+	memcpy(&image, args->structureInput, sizeof(image));
+	if (!image.address || !image.width || !image.height ||
+	    image.width > MINISURF_MAX_DIMENSION || image.height > MINISURF_MAX_DIMENSION ||
+	    !image.bytesPerElement || image.bytesPerElement > 16 ||
+	    image.bytesPerRow < (uint64_t)image.width * image.bytesPerElement ||
+	    image.allocSize < (uint64_t)image.bytesPerRow * image.height ||
+	    image.allocSize > MINISURF_MAX_ALLOC || image.address > ~0ULL - image.allocSize)
+		return kIOReturnBadArgument;
+	OSDictionary *props = OSDictionary::withCapacity(7);
+	if (!props) return kIOReturnNoMemory;
+	const struct { const char *key; uint64_t value; } values[] = {
+		{"IOSurfaceAddress", image.address}, {"IOSurfaceWidth", image.width},
+		{"IOSurfaceHeight", image.height}, {"IOSurfacePixelFormat", image.format},
+		{"IOSurfaceBytesPerElement", image.bytesPerElement},
+		{"IOSurfaceBytesPerRow", image.bytesPerRow}, {"IOSurfaceAllocSize", image.allocSize}
+	};
+	for (unsigned i = 0; i < sizeof(values) / sizeof(values[0]); i++) {
+		OSNumber *value = OSNumber::withNumber(values[i].value, 64);
+		bool added = value && props->setObject(values[i].key, value);
+		OSSafeReleaseNULL(value);
+		if (!added) { props->release(); return kIOReturnNoMemory; }
+	}
+	IOReturn ret;
+	MiniIOSurface *surface = surfaceCreate(props, &ret);
+	props->release();
+	if (!surface) return ret;
+	IOLockLock(gSurfaceLock);
+	struct minisurf_client_ref *ref = addRef(surface);
+	ret = ref ? returnSurface(ref, false, args) : kIOReturnNoMemory;
+	if (ref && ret != kIOReturnSuccess) dropRef(ref);
+	surfaceUnhold(surface);
+	IOLockUnlock(gSurfaceLock);
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodLookup(IOExternalMethodArguments * args)
+{
+	IOReturn ret = kIOReturnNotFound;
+	uint32_t sid;
+	struct minisurf_client_ref * ref;
+	bool added = false;
+
+	if (args->scalarInputCount < 1) {
+		return kIOReturnBadArgument;
+	}
+	sid = (uint32_t) args->scalarInput[0];
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, false);
+	if (ref == NULL && sid != 0 && sid < MINISURF_TABLE_SIZE && gSurfaceTable[sid] != NULL) {
+		ref = addRef(gSurfaceTable[sid]);
+		added = ref != NULL;
+		if (ref == NULL) {
+			ret = kIOReturnNoMemory;
+		}
+	}
+	if (ref != NULL) {
+		ret = returnSurface(ref, false, args);
+		if (added && ret != kIOReturnSuccess) {
+			dropRef(ref);
+		}
+	}
+	IOLockUnlock(gSurfaceLock);
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodLookupFromPort(IOExternalMethodArguments * args)
+{
+	IOReturn ret;
+	OSObject * obj = NULL;
+	IOSurfaceSendRight * right;
+	struct minisurf_client_ref * ref;
+	bool known;
+
+	if (args->scalarInputCount < 1) {
+		return kIOReturnBadArgument;
+	}
+	ret = copyObjectForPortNameInTask(fTask, (mach_port_name_t) args->scalarInput[0], &obj);
+	right = OSDynamicCast(IOSurfaceSendRight, obj);
+	if (ret != kIOReturnSuccess || right == NULL || right->surface == NULL) {
+		static unsigned said;
+
+		if (said++ < 16) {
+			char procname[32] = "?";
+
+			proc_selfname(procname, sizeof(procname));
+			traceLine("MiniIOSurface: %s[%d] looked up a surface from port %#llx: %s\n", procname, proc_selfpid(),
+			    args->scalarInput[0], ret != kIOReturnSuccess ? "no object behind the port" : obj ? "not a surface's port" :
+			    "no surface");
+		}
+		OSSafeReleaseNULL(obj);
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(gSurfaceLock);
+	ref = findRef(right->surface->sid, false);
+	known = ref != NULL;
+	if (ref == NULL) {
+		ref = addRef(right->surface);
+	}
+	ret = ref ? returnSurface(ref, known, args) : kIOReturnNoMemory;
+	if (ref != NULL && !known && ret != kIOReturnSuccess) {
+		dropRef(ref);
+	}
+	IOLockUnlock(gSurfaceLock);
+	if (right->surface->traced) {
+		char procname[32] = "?";
+		uint32_t format = right->surface->info.pixelFormat, nonzero = 0, first = 0, middle = 0;
+		const uint8_t * pixels = right->surface->kpixels;
+		uint32_t size = right->surface->info.allocSize;
+
+		/* what is in it by now: how many of its bytes are not zero, its first pixel and one in the middle */
+		for (uint32_t at = 0; pixels != NULL && at + 4 <= size; at += 64) {
+			nonzero += pixels[at] != 0 || pixels[at + 1] != 0 || pixels[at + 2] != 0 || pixels[at + 3] != 0;
+		}
+		if (pixels != NULL && size >= 8) {
+			memcpy(&first, pixels, 4);
+			memcpy(&middle, pixels + (size / 2 & ~3u), 4);
+		}
+		proc_selfname(procname, sizeof(procname));
+		traceLine("MiniIOSurface: %s[%d] looked up surface %u (%ux%u '%c%c%c%c') from a port: %#x; of every 64 bytes %u of %u "
+		    "begin with a pixel that is not 0, the first %#010x, one in the middle %#010x\n", procname, proc_selfpid(),
+		    right->surface->sid, right->surface->info.width, right->surface->info.height, (int) (format >> 24 & 0xff),
+		    (int) (format >> 16 & 0xff), (int) (format >> 8 & 0xff), (int) (format & 0xff), ret, nonzero, size / 64, first, middle);
+	}
+	obj->release();
+	return ret;
+}
+
+mach_port_name_t
+IOSurfaceRootUserClient::makeSendRight(task_t task, MiniIOSurface * s)
+{
+	IOSurfaceSendRight * right;
+	mach_port_name_t name = 0;
+
+	right = OSTypeAlloc(IOSurfaceSendRight);
+	if (right == NULL || !right->init()) {
+		OSSafeReleaseNULL(right);
+		return 0;
+	}
+	IOLockLock(gSurfaceLock);
+	surfaceHold(s);                         /* for as long as the send right exists */
+	IOLockUnlock(gSurfaceLock);
+	right->surface = s;
+	copyPortNameForObjectInTask(task, right, &name);
+	right->release();
+	return name;
+}
+
+mach_port_name_t
+MiniIOSurfaceMakeSendRight(task_t task, MiniIOSurface * surface)
+{
+	return IOSurfaceRootUserClient::makeSendRight(task, surface);
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodCreatePort(IOExternalMethodArguments * args)
+{
+	MiniIOSurface * s;
+	mach_port_name_t name;
+
+	if (args->scalarInputCount < 1 || args->scalarOutputCount < 1) {
+		return kIOReturnBadArgument;
+	}
+	s = MiniIOSurfaceCopy((uint32_t) args->scalarInput[0]);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	name = makeSendRight(fTask, s);
+	if (s->traced) {
+		char procname[32] = "?";
+
+		proc_selfname(procname, sizeof(procname));
+		traceLine("MiniIOSurface: %s[%d] made a port for surface %u: %#x\n", procname, proc_selfpid(), s->sid, name);
+	}
+	MiniIOSurfaceDrop(s);
+	args->scalarOutput[0] = name;
+	args->scalarOutputCount = 1;
+	return name != 0 ? kIOReturnSuccess : kIOReturnNoMemory;
+}
+
+/* 22H374 value requests have a 12-byte header; changes return a 4-byte seed. */
+static IOReturn
+returnSeed(IOExternalMethodArguments * args, uint32_t seed)
+{
+	if (args->structureOutput != NULL && args->structureOutputSize >= sizeof(seed)) {
+		memcpy(args->structureOutput, &seed, sizeof(seed));
+		args->structureOutputSize = sizeof(seed);
+		return kIOReturnSuccess;
+	}
+	return kIOReturnNoSpace;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodSetValue(IOExternalMethodArguments * args, const uint8_t * in, size_t inSize)
+{
+	uint32_t sid, seed = 0;
+	OSObject * obj;
+	OSArray * array;
+	struct minisurf_client_ref * ref;
+	IOReturn ret = kIOReturnBadArgument;
+
+	if (inSize < MINISURF_VALUE_HEADER + 4 || args->structureOutput == NULL ||
+	    args->structureOutputSize < sizeof(seed)) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&sid, in, sizeof(sid));
+	obj = unserialize(in + MINISURF_VALUE_HEADER, inSize - MINISURF_VALUE_HEADER);
+	array = OSDynamicCast(OSArray, obj);
+	if (array == NULL) {
+		OSSafeReleaseNULL(obj);
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, false);
+	if (ref == NULL) {
+		ret = kIOReturnNotFound;
+	} else if (ref->surface->values != NULL) {
+		MiniIOSurface * s = ref->surface;
+		OSString * key = OSDynamicCast(OSString, array->getObject(1));
+		OSDictionary * all = OSDynamicCast(OSDictionary, array->getObject(0));
+		OSDictionary * replacement = NULL;
+
+		if (array->getCount() == 2 && key != NULL) {
+			replacement = OSDictionary::withDictionary(s->values);
+			ret = replacement && replacement->setObject(key, array->getObject(0)) ?
+			    kIOReturnSuccess : kIOReturnNoMemory;
+		} else if (array->getCount() == 1 && all != NULL) {
+			replacement = OSDictionary::withDictionary(s->values);
+			ret = replacement && replacement->merge(all) ? kIOReturnSuccess : kIOReturnNoMemory;
+		}
+		if (ret == kIOReturnSuccess) {
+			ret = s->replaceValues(replacement);
+			if (ret == kIOReturnSuccess) seed = s->shared()->valuesSeed;
+		}
+		OSSafeReleaseNULL(replacement);
+	}
+	IOLockUnlock(gSurfaceLock);
+	obj->release();
+	return ret == kIOReturnSuccess ? returnSeed(args, seed) : ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodRemoveValue(IOExternalMethodArguments * args, const uint8_t * in, size_t inSize)
+{
+	uint32_t sid, seed = 0;
+	struct minisurf_client_ref * ref;
+	IOReturn ret = kIOReturnNotFound;
+
+	if (inSize < MINISURF_VALUE_HEADER + 1 || in[inSize - 1] != 0 ||
+	    args->structureOutput == NULL || args->structureOutputSize < sizeof(seed)) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&sid, in, sizeof(sid));
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, false);
+	if (ref != NULL && ref->surface->values != NULL) {
+		MiniIOSurface * s = ref->surface;
+		const char * key = (const char *) in + MINISURF_VALUE_HEADER;
+		OSDictionary * replacement = OSDictionary::withDictionary(s->values);
+
+		if (replacement == NULL) {
+			ret = kIOReturnNoMemory;
+		} else {
+			if (key[0] == 0) replacement->flushCollection();
+			else replacement->removeObject(key);
+			ret = s->replaceValues(replacement);
+			if (ret == kIOReturnSuccess) seed = s->shared()->valuesSeed;
+			replacement->release();
+		}
+	}
+	IOLockUnlock(gSurfaceLock);
+	return ret == kIOReturnSuccess ? returnSeed(args, seed) : ret;
+}
+
+/* 22H374 reply: reserved word, seed, reserved word, then the serialized value. */
+IOReturn
+IOSurfaceRootUserClient::methodCopyValue(IOExternalMethodArguments * args, const uint8_t * in, size_t inSize)
+{
+	uint32_t sid, header[3] = { 0, 0, 0 };
+	struct minisurf_client_ref * ref;
+	OSSerialize * s = NULL;
+	IOReturn ret = kIOReturnNotFound;
+	uint32_t length = 0, total;
+
+	if (inSize < MINISURF_VALUE_HEADER + 1 || in[inSize - 1] != 0) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&sid, in, sizeof(sid));
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, false);
+	if (ref != NULL && ref->surface->values != NULL) {
+		const char * key = (const char *) in + MINISURF_VALUE_HEADER;
+		OSObject * value = key[0] ? ref->surface->values->getObject(key) : ref->surface->values;
+
+		header[1] = ref->surface->shared()->valuesSeed;
+		ret = kIOReturnSuccess;
+		if (value != NULL) {
+			s = OSSerialize::binaryWithCapacity(4096);
+			if (s == NULL || !value->serialize(s)) {
+				ret = kIOReturnNoMemory;
+			} else if (s->getLength() > UINT32_MAX - sizeof(header)) {
+				ret = kIOReturnNoSpace;
+			} else {
+				length = s->getLength();
+			}
+		}
+	}
+	IOLockUnlock(gSurfaceLock);
+
+	total = (uint32_t) sizeof(header) + length;
+	if (ret == kIOReturnSuccess) {
+		if (args->structureOutputDescriptor != NULL) {
+			IOMemoryDescriptor * out = args->structureOutputDescriptor;
+
+			if (out->getLength() < total) {
+				ret = kIOReturnNoSpace;
+			} else if ((ret = out->prepare()) == kIOReturnSuccess) {
+				if (out->writeBytes(0, header, sizeof(header)) != sizeof(header) ||
+				    (length != 0 && out->writeBytes(sizeof(header), s->text(), length) != length)) {
+					ret = kIOReturnVMError;
+				}
+				IOReturn completed = out->complete();
+				if (ret == kIOReturnSuccess) {
+					ret = completed;
+				}
+				if (ret == kIOReturnSuccess) {
+					args->structureOutputDescriptorSize = total;
+				}
+			}
+		} else if (args->structureOutput == NULL || args->structureOutputSize < total) {
+			ret = kIOReturnNoSpace;
+		} else {
+			memcpy(args->structureOutput, header, sizeof(header));
+			if (length != 0) {
+				memcpy((uint8_t *) args->structureOutput + sizeof(header), s->text(), length);
+			}
+			args->structureOutputSize = total;
+		}
+	}
+	OSSafeReleaseNULL(s);
+	return ret;
+}
+
+/*
+ * Colour space, transfer function and the like: a fixed structure kept in the shared page.
+ * The request: the structure, its size, a mask of the fields that changed, the surface number.
+ */
+IOReturn
+IOSurfaceRootUserClient::methodSetBulkAttachments(const uint8_t * in, size_t inSize)
+{
+	uint64_t size, mask;
+	uint32_t sid;
+	struct minisurf_client_ref * ref;
+	IOReturn ret = kIOReturnNotFound;
+
+	/* 22H374 sends 0x74 bytes of attachments in a padded 0x78-byte
+	 * region, followed by size, dirty mask and surface ID. The old
+	 * 0x88-byte request reads colour metadata as its size and ID. */
+	if (inSize != 0x90) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&size, in + 0x78, sizeof(size));
+	memcpy(&mask, in + 0x80, sizeof(mask));
+	memcpy(&sid, in + 0x88, sizeof(sid));
+	if (size > 0x74 || (mask & ~MINISURF_ATTACHMENT_MASK)) {
+		return kIOReturnBadArgument;
+	}
+	for (unsigned i = 0; i < 18; i++) {
+		if ((mask & (1ULL << i)) && kSurfaceAttachmentFields[i].to > size) {
+			return kIOReturnBadArgument;
+		}
+	}
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, false);
+	if (ref != NULL) {
+		uint8_t * attachments = ref->surface->shared()->attachments;
+
+		for (unsigned i = 0; i < 18; i++) {
+			if (mask & (1ULL << i)) {
+				const auto & field = kSurfaceAttachmentFields[i];
+				memcpy(attachments + field.from, in + field.from, field.to - field.from);
+			}
+		}
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gSurfaceLock);
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::methodSetCoreVideoBridgedKeys(const uint8_t * in, size_t inSize)
+{
+	if (inSize < MINISURF_VALUE_HEADER + 4) return kIOReturnBadArgument;
+	OSObject * object = unserialize(in + MINISURF_VALUE_HEADER, inSize - MINISURF_VALUE_HEADER);
+	OSArray * keys = OSDynamicCast(OSArray, object);
+	if (keys == NULL) {
+		OSSafeReleaseNULL(object);
+		return kIOReturnBadArgument;
+	}
+	for (unsigned i = 0; i < keys->getCount(); i++) {
+		if (OSDynamicCast(OSString, keys->getObject(i)) == NULL) {
+			object->release();
+			return kIOReturnBadArgument;
+		}
+	}
+	IOLockLock(gSurfaceLock);
+	OSArray * previous = fCoreVideoKeys;
+	fCoreVideoKeys = keys; /* transfer the parsed object's reference */
+	IOLockUnlock(gSurfaceLock);
+	OSSafeReleaseNULL(previous);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOSurfaceRootUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	const uint8_t * in = (const uint8_t *) args->structureInput;
+	size_t inSize = args->structureInputSize;
+	IOMemoryMap * inMap = NULL;
+	struct minisurf_client_ref * ref;
+	IOReturn ret;
+
+	switch (selector) {
+	case kSurfaceMethodInit:
+		return methodInit(args);
+	case kSurfaceMethodCreate:
+		return methodCreate(args);
+	case kSurfaceMethodWrapClientImage:
+		return methodWrapClientImage(args);
+	case kSurfaceMethodLookup:
+		return methodLookup(args);
+	case kSurfaceMethodLookupFromPort:
+		return methodLookupFromPort(args);
+	case kSurfaceMethodCreatePort:
+		return methodCreatePort(args);
+
+	case kSurfaceMethodSetValue:
+	case kSurfaceMethodCopyValue:
+	case kSurfaceMethodRemoveValue:
+	case kSurfaceMethodSetBulkAttachments:
+	case kSurfaceMethodSetCoreVideoBridgedKeys:
+		if (args->structureInputDescriptor != NULL) {
+			inMap = args->structureInputDescriptor->map(kIOMapReadOnly);
+			if (inMap == NULL) {
+				return kIOReturnNoMemory;
+			}
+			in = (const uint8_t *) inMap->getVirtualAddress();
+			inSize = inMap->getLength();
+		}
+		if (in == NULL) {
+			ret = kIOReturnBadArgument;
+		} else if (selector == kSurfaceMethodSetValue) {
+			ret = methodSetValue(args, in, inSize);
+		} else if (selector == kSurfaceMethodCopyValue) {
+			ret = methodCopyValue(args, in, inSize);
+		} else if (selector == kSurfaceMethodRemoveValue) {
+			ret = methodRemoveValue(args, in, inSize);
+		} else if (selector == kSurfaceMethodSetCoreVideoBridgedKeys) {
+			ret = methodSetCoreVideoBridgedKeys(in, inSize);
+		} else {
+			ret = methodSetBulkAttachments(in, inSize);
+		}
+		OSSafeReleaseNULL(inMap);
+		return ret;
+
+	case kSurfaceMethodSetPurgeable:                /* in: surface, new state; out: old state */
+		if (args->scalarInputCount < 2) {
+			return kIOReturnBadArgument;
+		}
+		ret = kIOReturnNotFound;
+		IOLockLock(gSurfaceLock);
+		ref = findRef((uint32_t) args->scalarInput[0], false);
+		if (ref != NULL) {
+			if (args->scalarOutputCount >= 1) {
+				args->scalarOutput[0] = ref->surface->purgeable;
+				args->scalarOutputCount = 1;
+			}
+			if (args->scalarInput[1] != 3) {        /* 3 = keep current */
+				ref->surface->purgeable = (uint32_t) args->scalarInput[1];
+			}
+			ret = kIOReturnSuccess;
+		}
+		IOLockUnlock(gSurfaceLock);
+		return ret;
+
+	case kSurfaceMethodBindAccel:                   /* in: surface, accelerator, sub-id */
+		if (args->scalarInputCount < 3) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(gSurfaceLock);
+		ref = findRef((uint32_t) args->scalarInput[0], false);
+		if (ref != NULL) {
+			ref->surface->shared()->accelID = (uint16_t) args->scalarInput[1];
+			ref->surface->shared()->accelSubID = (uint16_t) args->scalarInput[2];
+		}
+		IOLockUnlock(gSurfaceLock);
+		return ref ? kIOReturnSuccess : kIOReturnNotFound;
+
+	case kSurfaceMethodSetYCbCrMatrix:              /* in: surface, matrix */
+		if (args->scalarInputCount != 2 || args->scalarInput[1] > UINT8_MAX) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(gSurfaceLock);
+		ref = findRef((uint32_t) args->scalarInput[0], false);
+		if (ref != NULL) {
+			ref->surface->shared()->attachments[0x3a] = (uint8_t) args->scalarInput[1];
+		}
+		IOLockUnlock(gSurfaceLock);
+		return ref ? kIOReturnSuccess : kIOReturnNotFound;
+
+	case kSurfaceMethodSetIndexedTimestamp:
+		if (args->scalarInputCount != 3 || args->scalarInput[1] >= 5) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(gSurfaceLock);
+		ref = findRef((uint32_t) args->scalarInput[0], false);
+		if (ref != NULL) {
+			ref->surface->aux()->timestamps[args->scalarInput[1]] = args->scalarInput[2];
+		}
+		IOLockUnlock(gSurfaceLock);
+		return ref ? kIOReturnSuccess : kIOReturnNotFound;
+
+	case kSurfaceMethodDetachModeCode:
+		if (args->scalarInputCount != 4) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(gSurfaceLock);
+		ref = findRef((uint32_t) args->scalarInput[0], false);
+		if (ref != NULL) {
+			struct minisurf_aux * aux = ref->surface->aux();
+			uint64_t mask = args->scalarInput[1];
+			aux->detachModeCode = (aux->detachModeCode & ~mask) | (args->scalarInput[2] & mask);
+			if (args->scalarInput[3] != 0) {
+				aux->timestamps[2] = args->scalarInput[3];
+			}
+		}
+		IOLockUnlock(gSurfaceLock);
+		return ref ? kIOReturnSuccess : kIOReturnNotFound;
+
+	case kSurfaceMethodLog:
+		/* Diagnostics have no state-changing completion to acknowledge. */
+		if (args->scalarOutputCount != 0) {
+			bzero(args->scalarOutput, args->scalarOutputCount * sizeof(args->scalarOutput[0]));
+		}
+		return kIOReturnSuccess;
+
+	default:
+		/* In particular, selector 24 is an event/serialized-value request,
+		 * not the indexed timestamp setter (33). Do not claim ownership
+		 * transfers or asynchronous timestamp events completed when this
+		 * CPU backend has no implementation for them. */
+		break;
+	}
+
+	if (selector < 128 && !(gSurfaceLogged[selector / 64] & (1ULL << (selector % 64)))) {
+		gSurfaceLogged[selector / 64] |= 1ULL << (selector % 64);
+		IOLog("MiniIOSurface: selector %u not implemented (scalars %u in, %u out; structure %u in, %u out)\n", selector,
+		    args->scalarInputCount, args->scalarOutputCount, args->structureInputSize, args->structureOutputSize);
+	}
+	return kIOReturnUnsupported;
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+IOExternalTrap *
+IOSurfaceRootUserClient::getTargetAndTrapForIndex(IOService ** targetP, UInt32 index)
+{
+	if (index >= kSurfaceTrapCount || fTraps[index].func == NULL) {
+		return NULL;
+	}
+	*targetP = this;
+	return &fTraps[index];
+}
+
+IOReturn
+IOSurfaceRootUserClient::useCountCommon(uint32_t sid, uint32_t category, int delta)
+{
+	struct minisurf_client_ref * ref;
+	IOReturn ret = kIOReturnNotFound;
+
+	if (category > 1) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, false);
+	if (ref != NULL) {
+		MiniIOSurface * s = ref->surface;
+
+		if (delta > 0 && (ref->use[category] == UINT32_MAX || s->useCount[category] == UINT32_MAX)) {
+			IOLockUnlock(gSurfaceLock);
+			return kIOReturnNoResources;
+		}
+		if (delta > 0 || ref->use[category] != 0) {
+			ref->use[category] += delta;
+			s->useCount[category] += delta;
+			s->shared()->useCount = (uint64_t) s->useCount[1] << 32 | s->useCount[0];
+		}
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gSurfaceLock);
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapRemoveBulkAttachments(void * p1, void * p2, void *, void *, void *, void *)
+{
+	uint64_t mask = (uintptr_t) p2;
+	if (mask & ~MINISURF_ATTACHMENT_MASK) return kIOReturnBadArgument;
+	IOLockLock(gSurfaceLock);
+	struct minisurf_client_ref * ref = findRef((uint32_t) (uintptr_t) p1, false);
+	if (ref != NULL) {
+		uint8_t * attachments = ref->surface->shared()->attachments;
+		for (unsigned i = 0; i < 18; i++) {
+			if (mask & (1ULL << i)) {
+				const auto & field = kSurfaceAttachmentFields[i];
+				bzero(attachments + field.from, field.to - field.from);
+			}
+		}
+	}
+	IOLockUnlock(gSurfaceLock);
+	return ref ? kIOReturnSuccess : kIOReturnNotFound;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapRemoveCoreVideoBridgedValues(void * p1, void * p2, void *, void *, void *, void *)
+{
+	IOReturn ret = kIOReturnNotFound;
+	uint32_t seed = 0;
+	IOLockLock(gSurfaceLock);
+	struct minisurf_client_ref * ref = findRef((uint32_t) (uintptr_t) p1, false);
+	if (ref != NULL) {
+		MiniIOSurface * s = ref->surface;
+		OSDictionary * replacement = OSDictionary::withDictionary(s->values);
+		ret = kIOReturnNoMemory;
+		if (replacement != NULL) {
+			for (unsigned i = 0; fCoreVideoKeys != NULL && i < fCoreVideoKeys->getCount(); i++) {
+				replacement->removeObject(OSDynamicCast(OSString, fCoreVideoKeys->getObject(i)));
+			}
+			ret = s->replaceValues(replacement);
+			replacement->release();
+			if (ret == kIOReturnSuccess) {
+				bzero(s->shared()->attachments, sizeof(s->shared()->attachments));
+				seed = s->shared()->valuesSeed;
+			}
+		}
+	}
+	IOLockUnlock(gSurfaceLock);
+	if (ret == kIOReturnSuccess && p2 != NULL &&
+	    copyout(&seed, (user_addr_t) (uintptr_t) p2, sizeof(seed)) != 0) return kIOReturnVMError;
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapIncrementUseCount(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	return useCountCommon((uint32_t) (uintptr_t) p1, (uint32_t) (uintptr_t) p2, 1);
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapDecrementUseCount(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	return useCountCommon((uint32_t) (uintptr_t) p1, (uint32_t) (uintptr_t) p2, -1);
+}
+
+/*
+ * Lock and unlock do not exclude anybody: the memory is shared and always mapped.
+ * What matters is the seed, which tells readers that the pixels may have changed.
+ */
+IOReturn
+IOSurfaceRootUserClient::lockCommon(uint32_t sid, uint32_t options, user_addr_t seedOut)
+{
+	struct minisurf_client_ref * ref;
+	uint32_t seed = 0;
+
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, false);
+	if (ref != NULL) {
+		struct minisurf_shared * sh = ref->surface->shared();
+
+		if (!(options & kSurfaceLockReadOnly)) {
+			sh->seed++;
+		}
+		seed = sh->seed;
+	}
+	IOLockUnlock(gSurfaceLock);
+	if (ref == NULL) {
+		return kIOReturnNotFound;
+	}
+	if (seedOut != 0) {
+		if (copyout(&seed, seedOut, sizeof(seed)) != 0) {
+			return kIOReturnVMError;
+		}
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapLock(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	return lockCommon((uint32_t) (uintptr_t) p1, (uint32_t) (uintptr_t) p2, (user_addr_t) (uintptr_t) p3);
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapUnlock(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	return lockCommon((uint32_t) (uintptr_t) p1, (uint32_t) (uintptr_t) p2, (user_addr_t) (uintptr_t) p3);
+}
+
+/*
+ * A client drops a surface in two steps: "detach" while it still holds its own lock, and
+ * "release" after it. A lookup of the same surface in between must make a fresh view.
+ */
+IOReturn
+IOSurfaceRootUserClient::trapDetach(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	struct minisurf_client_ref * ref;
+
+	IOLockLock(gSurfaceLock);
+	ref = findRef((uint32_t) (uintptr_t) p1, false);
+	if (ref != NULL) {
+		ref->detached = true;
+	}
+	IOLockUnlock(gSurfaceLock);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapRelease(void * p1, void * p2, void * p3, void * p4, void * p5, void * p6)
+{
+	struct minisurf_client_ref * ref;
+	uint32_t sid = (uint32_t) (uintptr_t) p1;
+
+	IOLockLock(gSurfaceLock);
+	ref = findRef(sid, true);
+	if (ref == NULL) {
+		ref = findRef(sid, false);
+	}
+	if (ref != NULL) {
+		dropRef(ref);
+	}
+	IOLockUnlock(gSurfaceLock);
+	return ref ? kIOReturnSuccess : kIOReturnNotFound;
+}
+
+/* No GPU is registered in this port. Only CPU-written surfaces (no submitted
+ * GPU fence) may be considered ready; an unknown GPU fence is never completed. */
+bool
+MiniIOSurfaceDrawn(MiniIOSurface * surface, __unused uint64_t milliseconds)
+{
+	return surface != NULL && surface->drawn == 0;
+}
+
+extern "C" void
+native_pong_ui_services_start(void)
+{
+	uint32_t keybag = 0;
+	if (PE_parse_boot_argn("pong_software_keybag", &keybag, sizeof(keybag)) && keybag) {
+		MiniAppleKeyStoreStart();
+	}
+	uint32_t enable = 0;
+	if (!PE_parse_boot_argn("pong_display", &enable, sizeof(enable)) || !enable) {
+		return;
+	}
+	IOService * provider = IOService::getPlatform();
+	if (provider == NULL) {
+		IOLog("Pong UI: no platform provider; native display startup skipped\n");
+		return;
+	}
+	if (!MiniIOSurfaceStart(provider)) {
+		IOLog("Pong UI: IOSurface startup failed; framebuffer skipped\n");
+		return;
+	}
+	MiniIOMobileFramebufferStart(provider);
+}
+
+#endif /* Pong development IOSurface */
diff --git a/iokit/Kernel/MiniIOSurface.h b/iokit/Kernel/MiniIOSurface.h
new file mode 100644
index 0000000..41142e9
--- /dev/null
+++ b/iokit/Kernel/MiniIOSurface.h
@@ -0,0 +1,176 @@
+/*
+ * MiniIOSurface: a stand-in for Apple's closed IOSurface.kext, enough of it for the iOS
+ * window server and its clients to share pixel buffers on a machine without Apple hardware.
+ *
+ * The protocol (user client selectors, traps and the layout of the structures the kernel
+ * hands to IOSurface.framework) is adapted to the 22H374 user-space interface.
+ */
+#ifndef _IOKIT_MINIIOSURFACE_H
+#define _IOKIT_MINIIOSURFACE_H
+
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+
+#include "MiniDrivers.h"
+
+#define MINISURF_MAX_PLANES     20              /* 22H374's 0xc68-byte maximum reply */
+#define MINISURF_RESULT_MAX     0xc68           /* 22H374: 0x88-byte header + 20 x 0x98-byte planes */
+
+/* Internal plane description (0x80 bytes), widened to the 0x98-byte
+ * 22H374 wire representation by returnSurface(). */
+struct minisurf_plane {
+	uint32_t width;                         /* 0x00 */
+	uint32_t height;                        /* 0x04 */
+	uint32_t reserved08;
+	uint32_t offset;                        /* 0x0c from the base address */
+	uint32_t bytesPerRow;                   /* 0x10 */
+	uint32_t size;                          /* 0x14 */
+	uint16_t bytesPerElement;               /* 0x18 */
+	uint8_t  elementWidth;                  /* 0x1a */
+	uint8_t  elementHeight;                 /* 0x1b */
+	uint8_t  componentCount;                /* 0x1c */
+	uint8_t  addressFormat;                 /* 0x1d */
+	uint8_t  reserved1e[2];
+	uint8_t  componentBitDepth[4];          /* 0x20 */
+	uint8_t  componentBitOffset[4];         /* 0x24 */
+	uint8_t  componentName[4];              /* 0x28 */
+	uint8_t  componentType[4];              /* 0x2c */
+	uint8_t  componentRange[4];             /* 0x30 */
+	uint8_t  reserved34[0x20];
+	uint8_t  compression;                   /* 0x54: 1 = compressed, then there is no base address */
+	uint8_t  reserved55[0x1b];
+	uint32_t extendedPixels[4];             /* 0x70 */
+};
+
+/* Internal bounded surface description. Darwin 24 serializes its widened
+ * 22H374 wire representation explicitly in returnSurface(). */
+struct minisurf_result {
+	uint64_t base;                          /* 0x00 where the memory is mapped in the client */
+	uint64_t shared;                        /* 0x08 struct minisurf_shared, mapped in the client */
+	uint64_t aux;                           /* 0x10 struct minisurf_aux, mapped in the client */
+	uint32_t sid;                           /* 0x18 */
+	uint32_t allocSize;                     /* 0x1c */
+	uint32_t width;                         /* 0x20 */
+	uint32_t height;                        /* 0x24 */
+	uint32_t bytesPerRow;                   /* 0x28 */
+	uint32_t offset;                        /* 0x2c */
+	uint32_t pixelFormat;                   /* 0x30 */
+	uint32_t reserved34;
+	uint32_t planeCount;                    /* 0x38 */
+	uint32_t reserved3c;
+	uint16_t bytesPerElement;               /* 0x40 */
+	uint8_t  elementWidth;                  /* 0x42 */
+	uint8_t  elementHeight;                 /* 0x43 */
+	uint32_t cacheMode;                     /* 0x44 */
+	uint32_t lockSeed;                      /* 0x48 the client keeps the seed of its last lock here */
+	uint8_t  subsampling;                   /* 0x4c */
+	uint8_t  prohibitUseCount;              /* 0x4d */
+	uint16_t reserved4e;
+	uint32_t parentID;                      /* 0x50 */
+	uint32_t sliceCount;                    /* 0x54 */
+	uint64_t traceID;                       /* 0x58 */
+	uint64_t protectionOptions;             /* 0x60 */
+};
+
+/* State that every client reads straight from memory shared with the kernel. */
+struct minisurf_shared {
+	uint64_t registryID;                    /* 0x00 */
+	uint16_t accelID;                       /* 0x08 */
+	uint16_t accelSubID;                    /* 0x0a */
+	uint32_t seed;                          /* 0x0c changes when somebody has written the pixels */
+	uint32_t reserved10;
+	uint8_t  tiled;                         /* 0x14 */
+	uint8_t  reserved15[3];
+	uint64_t useCount;                      /* 0x18 two 32-bit counters, one per category */
+	uint32_t valuesSeed;                    /* 0x20 */
+	uint32_t wiringAssertionCount;          /* 0x24 in 22H374; colour metadata lives in attachments */
+	uint32_t valuesSize;                    /* 0x28 room needed to fetch the values; 0 = none */
+	uint8_t  pixelSizeCasting;              /* 0x2c */
+	uint8_t  displayable;                   /* 0x2d */
+	uint8_t  sysMemOnly;                    /* 0x2e */
+	uint8_t  reserved2f;
+	uint8_t  attachments[0x74];             /* 0x30 the 22H374 bulk attachments; YCbCr matrix at +0x3a */
+};
+
+struct minisurf_aux {
+	uint64_t timestamps[5];                 /* 22H374 accepts indices 0 through 4 */
+	uint64_t detachModeCode;                /* 0x28 */
+};
+
+#define MINISURF_AUX_OFFSET     0x400           /* of the aux structure inside the shared page */
+
+class MiniIOSurface : public OSObject
+{
+	OSDeclareDefaultStructors(MiniIOSurface);
+
+public:
+	uint32_t                        sid;
+	uint32_t                        holders;        /* clients, send rights, kernel users */
+	IOBufferMemoryDescriptor *      memory;         /* one page of shared state, then the pixels */
+	uint8_t *                       kbase;          /* the same, in the kernel */
+	/*
+	 * ... unless the surface was made around memory its maker has already (IOSurfaceAddress):
+	 * then the pixels are that memory, held in place and seen from the kernel as well, and
+	 * `memory` is the page of shared state alone.
+	 */
+	IOMemoryDescriptor *            client;
+	IOMemoryMap *                   clientMap;
+	task_t                          clientTask;     /* retained owner of wrapped pixel memory */
+	mach_vm_address_t               clientAddress;  /* ... and where it is there */
+	uint8_t *                       kpixels;        /* where the pixel memory starts in the kernel, either way */
+	uint32_t                        drawn;          /* nonzero means a submitted GPU fence; CPU surfaces use zero */
+	struct minisurf_result          info;           /* addresses not filled in */
+	struct minisurf_plane           planes[MINISURF_MAX_PLANES];
+	OSDictionary *                  values;
+	uint32_t                        useCount[2];
+	uint32_t                        purgeable;
+	bool                            traced;         /* made by a program of boot-arg surftrace_of: its ports are said too */
+
+	virtual bool
+	init(void) APPLE_KEXT_OVERRIDE
+	{
+		return OSObject::init();
+	}
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+
+	struct minisurf_shared *
+	shared(void) const
+	{
+		return (struct minisurf_shared *) kbase;
+	}
+	struct minisurf_aux *
+	aux(void) const
+	{
+		return (struct minisurf_aux *) (kbase + MINISURF_AUX_OFFSET);
+	}
+	/* The first byte of the pixels (the "base address" clients see). */
+	uint8_t *
+	pixels(void) const
+	{
+		return kpixels + info.offset;
+	}
+	IOReturn replaceValues(OSDictionary * replacement);
+};
+
+/*
+ * For other parts of the kernel (the framebuffer).
+ * A surface found or made here is held until MiniIOSurfaceDrop().
+ */
+MiniIOSurface * MiniIOSurfaceCopy(uint32_t sid);
+/*
+ * What making and freeing surfaces has cost since this was last asked: how many, microseconds
+ * each; how many got memory that was kept from one before.
+ */
+void            MiniIOSurfaceCost(uint32_t * made, uint64_t * making, uint32_t * freed, uint64_t * freeing, uint32_t * again);
+/* Clear the memory that is kept of surfaces that are gone, for the next ones: when the caller has a moment. */
+void            MiniIOSurfaceClearKept(void);
+/* True only when the surface has no pending GPU fence in this CPU backend. */
+bool            MiniIOSurfaceDrawn(MiniIOSurface * surface, uint64_t milliseconds);
+MiniIOSurface * MiniIOSurfaceCreateSimple(uint32_t width, uint32_t height, uint32_t pixelFormat);
+void            MiniIOSurfaceDrop(MiniIOSurface * surface);
+/* A Mach send right for the surface in the task (what IOSurfaceCreateMachPort gives); 0 on failure. */
+mach_port_name_t MiniIOSurfaceMakeSendRight(task_t task, MiniIOSurface * surface);
+
+
+#endif /* _IOKIT_MINIIOSURFACE_H */
