+/* Pong's ordinary console already mirrors output to ramoops. */
+static void
+traceLine(const char * format, ...)
+{
+	char line[256];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
