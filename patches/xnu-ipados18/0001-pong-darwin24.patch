+{
+    DTEntry chosen;
+    unsigned length = 0;
+    const void *property = NULL;
+    uint64_t wire[4 + PONG_RAM_RANGE_MAX * 2];
+    pong_ram_ranges[0] = (struct pong_ram_range){args->physBase, args->physBase + args->memSize, 0};
+    pong_ram_range_count = 1;
+    pong_ram_bytes = args->memSize;
+    if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+        SecureDTGetProperty(chosen, "darwinboot-memory-ranges", &property, &length) != kSuccess ||
+        !property || length != sizeof(wire)) return;
+    /* Apple DT properties have four-byte alignment. Early SCTLR_EL1 may still
+     * enforce alignment, so do not read this wire payload with uint64_t loads.
+     * Volatile byte reads also prevent widening before the aligned local copy. */
+    const volatile uint8_t *source = (const volatile uint8_t *)property;
+    for (unsigned i = 0; i < sizeof(wire); i++)
+        ((uint8_t *)wire)[i] = source[i];
+    if (wire[0] != 1 || !wire[1] || wire[1] > PONG_RAM_RANGE_MAX || wire[3] ||
+        wire[4] != args->physBase || wire[5] != args->memSize) return;
+    uint64_t total = args->memSize;
+    for (unsigned i = 1; i < wire[1]; i++) {
