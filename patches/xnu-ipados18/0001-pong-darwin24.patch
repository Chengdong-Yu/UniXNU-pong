+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef _PEXPERT_ARM64_PONG_H
+#define _PEXPERT_ARM64_PONG_H
+
+// Nothing Phone (2), SM8475: firmware PSCI and the native GICv3 CPU provider.
+#define PONG 1
+#define GENERIC_PSCI_SMP 1
+#define NO_MONITOR 1
