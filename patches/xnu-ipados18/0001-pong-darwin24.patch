diff --git a/osfmk/arm64/pong_ramoops_console.h b/osfmk/arm64/pong_ramoops_console.h
new file mode 100644
index 0000000..d3ff8ea
--- /dev/null
+++ b/osfmk/arm64/pong_ramoops_console.h
@@ -0,0 +1,149 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Minimal persistent console mirror for Pong. It does not touch VBAR, TTBR,
+ * the framebuffer, scheduler state, IOKit, or storage. */
+#include <arm/caches_internal.h>
+#include <machine/machine_routines.h>
+
+#define PONG_RAMOOPS_PHYS_BASE 0x85200000ULL
+#define PONG_RAMOOPS_CONSOLE_BYTES 0x00200000U
+#define PONG_RAMOOPS_RESERVED_BYTES 0x00400000U
+#define PONG_RAMOOPS_HEADER_BYTES 12U
+#define PONG_RAMOOPS_MAGIC 0x43474244U
+#define PONG_RAMOOPS_DATA_BYTES (PONG_RAMOOPS_CONSOLE_BYTES - PONG_RAMOOPS_HEADER_BYTES)
+
+struct pong_ramoops_header {
+	volatile uint32_t sig;
+	volatile uint32_t start;
+	volatile uint32_t size;
+};
+
+static vm_offset_t pong_ramoops_base;
+static uint32_t pong_ramoops_start;
+static uint32_t pong_ramoops_size;
+static volatile uint32_t pong_ramoops_busy;
+static volatile uint32_t pong_diagnostic_busy;
+static uint32_t pong_diagnostic_size;
+
+/* The second 2 MiB is Pong DT's pmsg zone. Keep a separate bounded record
+ * there so launchd's console traffic cannot evict application failure data.
+ * Linux exposes the previous raw bytes as pmsg-ramoops-0 on the next boot.
+ * This is a persistent_ram buffer, not an Android logcat record stream.
+ * No storage, allocation, registry access or MMIO outside the DT reserve.
+ */
+void pong_ramoops_diagnostic_write(const char *, int);
+void
+pong_ramoops_diagnostic_write(const char *text, int length)
+{
+	if (!text || length <= 0 || length > 2048 || !pong_ramoops_base ||
+	    __atomic_exchange_n(&pong_diagnostic_busy, 1, __ATOMIC_ACQUIRE)) return;
+	vm_offset_t base = pong_ramoops_base + PONG_RAMOOPS_CONSOLE_BYTES;
+	struct pong_ramoops_header *header = (struct pong_ramoops_header *)(uintptr_t)base;
+	volatile uint8_t *data = (volatile uint8_t *)(uintptr_t)(base + PONG_RAMOOPS_HEADER_BYTES);
+	/* Append until full; preserve the first failures rather than overwrite them. */
+	uint32_t count = (uint32_t)length;
+	if (count > PONG_RAMOOPS_DATA_BYTES - pong_diagnostic_size)
+		count = PONG_RAMOOPS_DATA_BYTES - pong_diagnostic_size;
+	if (count) {
+		for (uint32_t i = 0; i < count; i++) data[pong_diagnostic_size + i] = (uint8_t)text[i];
+		CleanPoC_DcacheRegion_Force(base + PONG_RAMOOPS_HEADER_BYTES + pong_diagnostic_size, count);
+		__asm__ volatile("dsb sy" ::: "memory");
+		pong_diagnostic_size += count;
+		header->start = pong_diagnostic_size;
+		header->size = pong_diagnostic_size;
+		header->sig = PONG_RAMOOPS_MAGIC;
+		CleanPoC_DcacheRegion_Force(base, PONG_RAMOOPS_HEADER_BYTES);
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	__atomic_store_n(&pong_diagnostic_busy, 0, __ATOMIC_RELEASE);
+}
+
+void pong_ramoops_console_write(const char *, int);
+void
+pong_ramoops_console_write(const char *text, int length)
+{
+	if (!text || length <= 0 || !pong_ramoops_base ||
+	    __atomic_exchange_n(&pong_ramoops_busy, 1, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+
+	const uint32_t capacity = PONG_RAMOOPS_DATA_BYTES;
+	uint32_t old_size = pong_ramoops_size;
+	uint32_t write_at = old_size < capacity ?
+	    (pong_ramoops_start + old_size) % capacity : pong_ramoops_start;
+	uint32_t count = (uint32_t)length;
+	uint32_t skip = 0;
+	if (count > capacity) {
+		skip = count - capacity;
+		count = capacity;
+	}
+	uint32_t data_at = (write_at + skip) % capacity;
+	const char *source = text + skip;
+	volatile uint8_t *data = (volatile uint8_t *)(uintptr_t)
+	    (pong_ramoops_base + PONG_RAMOOPS_HEADER_BYTES);
+	uint32_t first = capacity - data_at;
+	if (first > count) {
+		first = count;
+	}
+	for (uint32_t i = 0; i < first; i++) {
+		data[data_at + i] = (uint8_t)source[i];
+	}
+	uint32_t second = count - first;
+	for (uint32_t i = 0; i < second; i++) {
+		data[i] = (uint8_t)source[first + i];
+	}
+
+	if (first) {
+		CleanPoC_DcacheRegion_Force((vm_offset_t)(uintptr_t)(data + data_at), first);
+	}
+	if (second) {
+		CleanPoC_DcacheRegion_Force((vm_offset_t)(uintptr_t)data, second);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	uint64_t total = (uint64_t)old_size + (uint32_t)length;
+	uint32_t new_size = total >= capacity ? capacity : (uint32_t)total;
+	uint32_t new_start = total > capacity ?
+	    (uint32_t)((pong_ramoops_start + total - capacity) % capacity) : pong_ramoops_start;
+	struct pong_ramoops_header *header =
+	    (struct pong_ramoops_header *)(uintptr_t)pong_ramoops_base;
+	header->start = new_start;
+	header->size = new_size;
+	__asm__ volatile("dsb sy" ::: "memory");
+	CleanPoC_DcacheRegion_Force(pong_ramoops_base, PONG_RAMOOPS_HEADER_BYTES);
+	__asm__ volatile("dsb sy" ::: "memory");
+	pong_ramoops_start = new_start;
+	pong_ramoops_size = new_size;
+	__atomic_store_n(&pong_ramoops_busy, 0, __ATOMIC_RELEASE);
+}
+
+int
+pong_ramoops_console_init(void)
+{
+	if (pong_ramoops_base) {
+		return 1;
+	}
+	vm_offset_t mapped = ml_io_map_wcomb(PONG_RAMOOPS_PHYS_BASE,
+	    PONG_RAMOOPS_RESERVED_BYTES);
+	if (!mapped) {
+		return 0;
+	}
+
+	struct pong_ramoops_header *header =
+	    (struct pong_ramoops_header *)(uintptr_t)mapped;
+	header->sig = 0;
+	header->start = 0;
+	header->size = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	CleanPoC_DcacheRegion_Force(mapped, PONG_RAMOOPS_HEADER_BYTES);
+	header->sig = PONG_RAMOOPS_MAGIC;
+	__asm__ volatile("dsb sy" ::: "memory");
+	CleanPoC_DcacheRegion_Force(mapped, PONG_RAMOOPS_HEADER_BYTES);
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	pong_ramoops_start = 0;
+	pong_ramoops_size = 0;
+	pong_ramoops_base = mapped;
+	static const char ready[] = "PONG DIAGNOSTIC v92: isolated pmsg recorder ready\n";
+	pong_ramoops_diagnostic_write(ready, (int)sizeof(ready)-1);
+	return 1;
+}
